@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero-panel mb-4">
    <h1 class="h2 mb-2">Welcome to Hospital Portal</h1>
    <p>Monitor patient vitals, manage records, and review activity in one place.</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="app-card card h-100">
            <div class="card-body">
                <h2 class="h5 text-primary">Staff</h2>
                <p class="text-muted small mb-0">Doctors, nurses, and reception can manage patients, vitals, and system logs.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="app-card card h-100">
            <div class="card-body">
                <h2 class="h5 text-primary">Patients</h2>
                <p class="text-muted small mb-0">View your vitals trends and personal activity history from your dashboard.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="app-card card h-100">
            <div class="card-body">
                <h2 class="h5 text-primary">Secure access</h2>
                <p class="text-muted small mb-0">Sign in with your assigned account to access role-appropriate features.</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Recent Patients</h5>
        <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Index">View all</a>
    </div>

    @if (Model.Patients.Count == 0)
    {
        @if (User.IsInRole("User"))
        {
            <p class="text-muted small"> No patients registered to view with you yet. </p>
            <button class="btn btn-primary"> Insert a relation code </button>
        }
        else
        {
            <p class="text-muted small"> No patients registered yet.</p>
        }
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Patient</th>
                        <th>Status</th>
                        <th>Medications</th>
                        <th>Nurse Call</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model.Patients.Take(5))  
                    {
                        <tr>
                            <td class="fw-medium">@patient.PatientName</td>
                            <td>
                                <span class="badge @(patient.IsDischarged ? "bg-secondary" : "bg-success")">
                                    @patient.Status
                                </span>
                            </td>
                            <td class="text-muted">@patient.MedicationsSummary</td>
                            <td>
                                @if (patient.NurseCall)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (User.IsInRole("Doctor"))
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Edit" asp-route-id="@patient.PatientId">Edit</a>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Edit" asp-route-id="@patient.PatientId">View</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
@page "{id:int}"
@model INFP_Proj.Pages.Admin.EditModel
@{
    ViewData["Title"] = "Edit Patient";
}

<style>
    .dashboard-card {
        border: 1px solid #dfe9e7;
        border-radius: 14px;
        overflow: hidden;
    }

        .dashboard-card .card-header {
            background: #ffffff;
            border-bottom: 1px solid #edf2f1;
            color: #006a72;
            font-weight: 700;
            padding: 1rem 1.15rem;
        }

        .dashboard-card .card-body {
            padding: 1.15rem;
        }

        .dashboard-card.section-danger .card-header {
            color: #b91c1c;
        }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.7rem 0;
        border-bottom: 1px solid #edf2f1;
    }

        .detail-row:last-child {
            border-bottom: 0;
        }

    .detail-label {
        color: #6c757d;
        font-size: 0.82rem;
    }

    .detail-value {
        text-align: right;
        font-size: 0.9rem;
        font-weight: 600;
        color: #263b38;
    }

    .doctor-message {
        background: #f8faf9;
        border: 1px solid #e1eae8;
        border-radius: 12px;
        padding: 1rem;
    }

        .doctor-message.doctor-message-completed {
            background: #f0f9f5;
            border-color: #bfe3d1;
        }

    @@media (max-width: 767.98px) {
        .detail-row {
            display: block;
        }

        .detail-value {
            text-align: left;
            margin-top: 0.2rem;
        }
    }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">@Model.Patient.PatientName</h1>
        <p class="page-subtitle text-muted">Update medications or discharge patient.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/PatientList">Patient list</a>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="dashboard-card app-card card mb-4">
    <div class="card-header">Patient details</div>
    <div class="card-body">
        <div class="detail-row">
            <span class="detail-label">Status</span>
            <span class="detail-value">
                <span class="badge @(Model.Patient.IsDischarged ? "bg-secondary" : "bg-success")">
                    @Model.Patient.Status
                </span>
            </span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Admitted</span>
            <span class="detail-value">@(Model.Patient.AdmissionDateTime?.ToLocalTime().ToString("g") ?? "—")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Discharged</span>
            <span class="detail-value">@(Model.Patient.DischargeDateTime?.ToLocalTime().ToString("g") ?? "—")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Nurse Call</span>
            <span class="detail-value">
                @if (Model.Patient.RequestHelp)
                {
                    <div class="d-flex align-items-center justify-content-end gap-2 flex-wrap">
                        <span class="badge bg-danger">Active</span>
                        @if (!User.IsInRole("Reception"))
                        {
                        <form method="post" asp-page-handler="AnswerNurseCall" asp-route-id="@Model.Patient.PatientId" class="m-0">
                            <button type="submit" class="btn btn-danger btn-sm fw-bold">
                                <i class="bi bi-check-circle me-1"></i> Answer Nurse Call
                            </button>
                        </form>
                        }
                    </div>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </span>
        </div>
    </div>
</div>

<div class="dashboard-card app-card card mb-4">
    <div class="card-header">Admission notes</div>
    <div class="card-body">
        @if (string.IsNullOrWhiteSpace(Model.Patient.AdmissionNotes))
        {
            <p class="text-muted mb-0">No admission notes recorded.</p>
        }
        else
        {
            <p class="mb-0">@Model.Patient.AdmissionNotes</p>
        }
    </div>
</div>

<div class="dashboard-card app-card card mb-4">
    <div class="card-header">Medications</div>
    <div class="card-body">
        @if (Model.Patient.MedicationLists.Count == 0)
        {
            <p class="text-muted mb-0">No medications assigned yet.</p>
        }
        else
        {
            <form method="post" asp-page-handler="UpdateMedications" asp-route-id="@Model.Patient.PatientId">
                <div class="app-table-wrapper table-responsive mb-3">
                    <table class="table align-middle mb-0">
                        <colgroup>
                            <col class="col-5" />
                            <col class="col-5" />
                            <col class="col-2" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Medication</th>
                                <th>Dosage</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Patient.MedicationLists.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="Patient.MedicationLists[i].MedicationListID" />
                                        <select asp-for="Patient.MedicationLists[i].MedicationID"
                                                asp-items="Model.MedicationOptions"
                                                class="form-select"
                                                disabled="@(Model.Patient.IsDischarged || !User.IsInRole("Doctor"))""></select>
                                    </td>
                                    <td>
                                        <input asp-for="Patient.MedicationLists[i].Dosage"
                                               class="form-control"
                                               disabled="@(Model.Patient.IsDischarged || !User.IsInRole("Doctor"))"" />
                                    </td>
                                    <td>
                                        @if (!Model.Patient.IsDischarged && User.IsInRole("Doctor"))
                                        {
                                            <button type="submit"
                                                    asp-page-handler="RemoveMedication"
                                                    asp-route-medicationListId="@Model.Patient.MedicationLists[i].MedicationListID"
                                                    asp-route-id="@Model.Patient.PatientId"
                                                    class="btn btn-outline-danger btn-sm">
                                                Remove
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!Model.Patient.IsDischarged && User.IsInRole("Doctor"))
                {
                    <button type="submit" class="btn btn-primary">Save medications</button>
                }
            </form>
        }

        @if (!Model.Patient.IsDischarged && User.IsInRole("Doctor"))
        {
            <hr class="my-4" />
            <h3 class="h6 text-primary mb-3">Add medication</h3>
            <form method="post" asp-page-handler="AddMedication" asp-route-id="@Model.Patient.PatientId" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label asp-for="Patient.NewMedicationID" class="form-label">Medication</label>
                    <select asp-for="Patient.NewMedicationID" asp-items="Model.MedicationOptions" class="form-select">
                        <option value="">— Select —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Patient.NewDosage" class="form-label">Dosage</label>
                    <input asp-for="Patient.NewDosage" class="form-control" placeholder="e.g. 500mg" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-primary w-100">Add</button>
                </div>
            </form>
        }
    </div>
</div>

<div class="dashboard-card app-card card mb-4">
    <div class="card-header">Doctor's request</div>
    <div class="card-body">

        @foreach (var request in Model.DoctorRequests)
        {
            <div class="doctor-message mb-3 @(request.Completed ? "doctor-message-completed" : "")">
                <p class="mb-1">@request.RequestMessage</p>
                @if (request.Completed)
                {
                    <p class="mb-1"><strong>Reply:</strong> @request.ReplyMessage</p>
                }

                <small class="text-muted">
                    @request.RequestDate.ToString("dd MMM yyyy, hh:mm tt")
                </small>

                @if (!request.Completed && User.IsInRole("Doctor"))
                {
                    <form method="post" asp-page-handler="ReplyDoctorRequest" asp-route-id="@Model.Patient.PatientId" class="d-flex gap-2 mt-2">
                        <input type="hidden" name="requestId" value="@request.DoctorRequestID" />
                        <input type="text" name="ReplyMessage" class="form-control" placeholder="Text" />
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </form>
                }
            </div>
        }

        <form method="post" asp-page-handler="SaveDoctorRequest" asp-route-id="@Model.Patient.PatientId">
            <textarea name="RequestMessage" class="form-control mb-2" rows="4"
                placeholder="Enter message for Doctor's Request"></textarea>
            <button type="submit" class="btn btn-primary"
                disabled="@Model.Patient.IsDischarged">Save</button>
        </form>

    </div>
</div>

<div class="app-card card section-danger">
    <div class="card-header">Discharge</div>
    <div class="card-body">
        @if (Model.Patient.IsDischarged)
        {
            <p class="text-muted mb-0">This patient has already been discharged.</p>
            <p class="mb-0"><strong>Reason for discharge:</strong> @Model.Patient.DischargeReason</p>
        }
        else
        {
            <p class="text-muted">Set discharge date to now and update patient status.</p>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#dischargeModal">
                    Discharge patient
                </button>

                @if (User.IsInRole("Doctor"))
                {
                    <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#deceasedModal">
                        Record as Deceased
                    </button>
                }
            </div>
        }
    </div>
</div>

@if (!Model.Patient.IsDischarged)
{
    <div class="modal fade" id="dischargeModal" tabindex="-1" aria-labelledby="dischargeModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-4">
                <form method="post" asp-page-handler="Discharge" asp-route-id="@Model.Patient.PatientId">
                    <div class="modal-header">
                        <h5 class="modal-title" id="dischargeModalLabel">Discharge patient</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Select a reason for discharging <strong>@Model.Patient.PatientName</strong>:</p>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="DischargeReason"
                                   id="reasonRecovered" value="Recovered" required>
                            <label class="form-check-label" for="reasonRecovered">Recovered</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="DischargeReason"
                                   id="reasonOutpatient" value="Outpatient Care">
                            <label class="form-check-label" for="reasonOutpatient">Outpatient Care</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="DischargeReason"
                                   id="reasonAMA" value="Against Medical Advice">
                            <label class="form-check-label" for="reasonAMA">Against Medical Advice</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Confirm discharge</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Doctor"))
    {
        <div class="modal fade" id="deceasedModal" tabindex="-1" aria-labelledby="deceasedModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content rounded-4">
                    <form method="post" asp-page-handler="DischargeDeceased" asp-route-id="@Model.Patient.PatientId">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deceasedModalLabel">Record as Deceased</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0">
                                Confirm that <strong>@Model.Patient.PatientName</strong> should be discharged
                                and recorded as <strong>Deceased</strong>. This cannot be undone.
                            </p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-dark">Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

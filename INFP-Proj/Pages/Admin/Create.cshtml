@page
@model INFP_Proj.Pages.Admin.CreateModel
@{
    ViewData["Title"] = "Admit Patient";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Admit patient</h1>
        <p class="page-subtitle text-muted">Admit an existing user as a patient and create their admission record.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="Index">Patient list</a>
    </div>
</div>

<div class="app-card card">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>

            <fieldset class="mb-4">
                <legend class="h6 text-primary mb-3">Patient</legend>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.UserId" class="form-label"></label>
                        <select asp-for="Input.UserId" class="form-select" asp-items="Model.UserOptions">
                            <option value="">— Select user —</option>
                        </select>
                        <span asp-validation-for="Input.UserId" class="text-danger small"></span>
                        <p class="form-text text-muted mb-0">Non-admin, non-patient users only.</p>
                    </div>
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="h6 text-primary mb-3">Bracelet</legend>
                <div class="btn-group mb-3" role="group" aria-label="Bracelet type">
                    <input type="radio" class="btn-check" name="Input.BraceletMode" id="braceletExisting" value="existing"
                           @(Model.Input.BraceletMode != "new" ? "checked" : null) autocomplete="off" />
                    <label class="btn btn-outline-primary" for="braceletExisting">Use existing bracelet</label>

                    <input type="radio" class="btn-check" name="Input.BraceletMode" id="braceletNew" value="new"
                           @(Model.Input.BraceletMode == "new" ? "checked" : null) autocomplete="off" />
                    <label class="btn btn-outline-primary" for="braceletNew">Create new bracelet</label>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div id="existingBraceletSection" class="@(Model.Input.BraceletMode == "new" ? "d-none" : "")">
                            <label asp-for="Input.BraceletID" class="form-label"></label>
                            <select asp-for="Input.BraceletID" class="form-select" asp-items="Model.BraceletOptions">
                                <option value="">— Select bracelet —</option>
                            </select>
                            <span asp-validation-for="Input.BraceletID" class="text-danger small"></span>
                            @if (!Model.HasAvailableBracelets)
                            {
                                <p class="form-text text-warning mb-0">No unassigned bracelets available — create a new one instead.</p>
                            }
                            else
                            {
                                <p class="form-text text-muted mb-0">Unassigned bracelets only.</p>
                            }
                        </div>

                        <div id="newBraceletSection" class="@(Model.Input.BraceletMode == "new" ? "" : "d-none")">
                            <label asp-for="Input.NewBraceletLocation" class="form-label"></label>
                            <input asp-for="Input.NewBraceletLocation" class="form-control" placeholder="e.g. Ward A" />
                            <span asp-validation-for="Input.NewBraceletLocation" class="text-danger small"></span>
                            <p class="form-text text-muted mb-0">A new bracelet is created and assigned to this patient.</p>
                        </div>
                    </div>
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="h6 text-primary mb-3">Admission record</legend>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.BedID" class="form-label"></label>
                        <select asp-for="Input.BedID" class="form-select" asp-items="Model.BedOptions">
                            <option value="">— Select bed —</option>
                        </select>
                        <span asp-validation-for="Input.BedID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.WardID" class="form-label"></label>
                        <select asp-for="Input.WardID" class="form-select" asp-items="Model.WardOptions">
                            <option value="">— Select ward —</option>
                        </select>
                        <span asp-validation-for="Input.WardID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.DiagnosisID" class="form-label"></label>
                        <select asp-for="Input.DiagnosisID" class="form-select" asp-items="Model.DiagnosisOptions">
                            <option value="">— Select diagnosis —</option>
                        </select>
                        <span asp-validation-for="Input.DiagnosisID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.MedicationIDs" class="form-label"></label>
                        <select asp-for="Input.MedicationIDs" class="form-select" asp-items="Model.MedicationOptions" multiple size="5"></select>
                        <span asp-validation-for="Input.MedicationIDs" class="text-danger small"></span>
                        <p class="form-text text-muted mb-0">Hold Ctrl (Cmd on Mac) to select multiple. Added to the patient's medication list.</p>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="2" placeholder="Optional admission notes"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>
                </div>
            </fieldset>

            <button type="submit" class="btn btn-primary">Admit patient</button>
            <a class="btn btn-outline-secondary ms-2" asp-page="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (function () {
            const existingBraceletSection = document.getElementById('existingBraceletSection');
            const newBraceletSection = document.getElementById('newBraceletSection');

            function updateSections() {
                const isNewBracelet = document.getElementById('braceletNew')?.checked;
                existingBraceletSection?.classList.toggle('d-none', isNewBracelet);
                newBraceletSection?.classList.toggle('d-none', !isNewBracelet);
            }

            document.querySelectorAll('input[name="Input.BraceletMode"]')
                .forEach(r => r.addEventListener('change', updateSections));
            updateSections();
        })();
    </script>
}

@page
@model INFP_Proj.Pages.Admin.CreateModel
@{
    ViewData["Title"] = "Add Patient";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Add new patient</h1>
        <p class="page-subtitle text-muted">Link a patient account to a bracelet.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="Index">Patient list</a>
    </div>
</div>

<div class="app-card card">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Patients.UserID" class="form-label">Patient user account</label>
                <select asp-for="Patients.UserID" class="form-select" asp-items="Model.UserOptions">
                    <option value="">— Select user —</option>
                </select>
                <span asp-validation-for="Patients.UserID" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Patients.BraceletID" class="form-label">Bracelet</label>
                <select asp-for="Patients.BraceletID" class="form-select" asp-items="Model.BraceletOptions">
                    <option value="">— Select bracelet —</option>
                </select>
                <span asp-validation-for="Patients.BraceletID" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Patients.Status" class="form-label">Status</label>
                <input asp-for="Patients.Status" class="form-control" placeholder="Admitted" />
                <span asp-validation-for="Patients.Status" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create patient</button>
            <a class="btn btn-outline-secondary ms-2" asp-page="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

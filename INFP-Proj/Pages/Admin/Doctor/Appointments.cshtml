@page
@model INFP_Proj.Pages.Admin.Doctor.AppointmentsModel
@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-calendar-medical"></i> My Appointments</h2>

    <!-- Pending Acknowledgments -->
    <div class="card shadow-sm mb-5 border-top border-warning border-4">
        <div class="card-header bg-white">
            <h4 class="mb-0 text-warning"><i class="bi bi-exclamation-circle"></i> Action Required</h4>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Patient</th>
                        <th>Reason</th>
                        <th>Urgency</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.PendingAppointments.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">You have no pending appointments to acknowledge.</td></tr>
                    }
                    @foreach (var appt in Model.PendingAppointments)
                    {
                        <tr>
                            <td class="align-middle fw-bold">@appt.DateTime.ToString("MMM dd, yyyy - hh:mm tt")</td>
                            <td class="align-middle">@appt.PatientName</td>
                            <td class="align-middle">@appt.Reason</td>
                            <td class="align-middle">
                                @if (appt.Urgency == "Emergency")
                                {
                                    <span class="badge bg-danger">Emergency</span>
                                }
                                else if (appt.Urgency == "Urgent")
                                {

                                    <span class="badge bg-warning text-dark">Urgent</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">Normal</span>
                                }
                            </td>
                            <td class="align-middle text-center">
                                <form method="post" class="d-inline">
                                    <button type="submit" asp-page-handler="Acknowledge" asp-route-id="@appt.AppointmentRequestID" class="btn btn-sm btn-success fw-bold me-1 shadow-sm">
                                        <i class="bi bi-check-lg"></i> Acknowledge
                                    </button>
                                </form>
                                <form method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to reject this appointment?');">
                                    <button type="submit" asp-page-handler="Reject" asp-route-id="@appt.AppointmentRequestID" class="btn btn-sm btn-outline-danger shadow-sm">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Upcoming Schedule -->
    <div class="card shadow-sm border-top border-primary border-4">
        <div class="card-header bg-white">
            <h4 class="mb-0 text-primary"><i class="bi bi-calendar-check"></i> Upcoming Schedule</h4>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Patient</th>
                        <th>Reason</th>
                        <th>Urgency</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.UpcomingAppointments.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No upcoming appointments scheduled.</td></tr>
                    }
                    @foreach (var appt in Model.UpcomingAppointments)
                    {
                        <tr>
                            <td class="align-middle fw-bold">@appt.DateTime.ToString("MMM dd, yyyy - hh:mm tt")</td>
                            <td class="align-middle">@appt.PatientName</td>
                            <td class="align-middle">@appt.Reason</td>
                            <td class="align-middle">
                                @if (appt.Urgency == "Emergency")
                                {
                                    <span class="badge bg-danger">Emergency</span>
                                }
                                else if (appt.Urgency == "Urgent")
                                {

                                    <span class="badge bg-warning text-dark">Urgent</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">Normal</span>
                                }
                            </td>
                            <td class="align-middle">
                                @if (appt.Status == "Scheduled")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Scheduled</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-hourglass-split"></i> Awaiting Patient</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
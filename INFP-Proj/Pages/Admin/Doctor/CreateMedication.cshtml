@page
@model INFP_Proj.Pages.Admin.Doctor.CreateMedicationModel
@{
    ViewData["Title"] = "Create";
}

<style>
    .dashboard-hero {
        background: linear-gradient(135deg, #087f73, #0a9b8c);
        color: white;
        border-radius: 18px;
        padding: 1.75rem;
    }

        .dashboard-hero p {
            color: rgba(255, 255, 255, 0.85);
        }

    .dashboard-card {
        border: 1px solid #dfe9e7;
        border-radius: 14px;
        overflow: hidden;
    }

        .dashboard-card .card-header {
            background: #ffffff;
            border-bottom: 1px solid #edf2f1;
            color: #006a72;
            font-weight: 700;
            padding: 1rem 1.15rem;
        }

        .dashboard-card .card-body {
            padding: 1.5rem;
        }

    .form-label, label.control-label {
        color: #173f3b;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .form-control:focus {
        border-color: #8cc6bf;
        box-shadow: 0 0 0 0.2rem rgba(10, 155, 140, 0.15);
    }

    .btn-primary {
        background-color: #0a9b8c;
        border-color: #0a9b8c;
    }

        .btn-primary:hover {
            background-color: #087f73;
            border-color: #087f73;
        }

    @@media (max-width: 767.98px) {
        .dashboard-hero {
            padding: 1.25rem;
        }
    }
</style>

<div class="container mt-4">

<div class="page-header">
    <div>
        <h1 class="page-title">Add Medication</h1>
        <p class="page-subtitle text-muted">Register new medications into the system.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Index">Return to dashboard</a>
    </div>
</div>

    <div class="row justify-content-center ">
        <div class="col-md-6 col-lg-5">
            <div class="dashboard-card">
                <div class="card-header">Medication details</div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group mb-3">
                            <label asp-for="Medications.MedicationName" class="control-label"></label>
                            <input asp-for="Medications.MedicationName" class="form-control" />
                            <span asp-validation-for="Medications.MedicationName" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="Medications.ConsumptionTime" class="control-label"></label>
                            <input asp-for="Medications.ConsumptionTime" class="form-control" />
                            <span asp-validation-for="Medications.ConsumptionTime" class="text-danger"></span>
                        </div>
                        <div class="form-group d-flex justify-content-between align-items-center">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to list
                            </a>
                            <button type="submit" class="btn btn-primary fw-bold">
                                <i class="bi bi-check-lg"></i> Create
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

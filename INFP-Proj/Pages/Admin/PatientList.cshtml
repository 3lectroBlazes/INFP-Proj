@page
@model INFP_Proj.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Patient List";
}

<style>
    .log-card {
        border: 1px solid #dfe9e7;
        border-radius: 15px;
        overflow: hidden;
    }

        .log-card .card-header {
            background: #ffffff;
            border-bottom: 1px solid #edf2f1;
            color: #006a72;
            font-weight: 700;
            padding: 1rem 1.2rem;
        }

    .log-table {
        margin-bottom: 0;
    }

        .log-table thead th {
            background: #f1f8f7;
            border-bottom: 1px solid #d8e7e4;
            color: #47615d;
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.035em;
            padding: 0.9rem 1rem;
            text-transform: uppercase;
            vertical-align: middle;
            white-space: nowrap;
        }

        .log-table tbody td {
            background: #ffffff;
            border-bottom: 1px solid #edf2f1;
            color: #263b38;
            padding: 1rem;
            vertical-align: middle;
        }

        .log-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .log-table tbody tr:hover td {
            background: #f9fbfb;
        }

        .log-table tbody tr.patient-admitted td:first-child {
            border-left: 4px solid #198754;
        }

        .log-table tbody tr.patient-discharged td:first-child {
            border-left: 4px solid #6c757d;
        }

    .empty-panel {
        background: #f8faf9;
        border: 1px dashed #cbd9d6;
        border-radius: 12px;
        padding: 2.25rem 1.25rem;
        text-align: center;
    }

    .ward-group {
        border: 1px solid #dfe9e7;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .ward-group-header {
        background: #f1f8f7;
        border: none;
        width: 100%;
        text-align: left;
        padding: 0.9rem 1.2rem;
        font-weight: 700;
        color: #006a72;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .ward-group-header .chevron {
            transition: transform 0.2s ease;
        }

        .ward-group-header[aria-expanded="true"] .chevron {
            transform: rotate(90deg);
        }

    .ward-capacity {
        font-weight: 400;
        font-size: 0.82rem;
        color: #6c757d;
    }

        .ward-capacity.ward-full {
            color: #b91c1c;
            font-weight: 600;
        }

    @@media (max-width: 767.98px) {
        .log-table thead {
            display: none;
        }

        .log-table, .log-table tbody, .log-table tr, .log-table td {
            display: block;
            width: 100%;
        }

            .log-table tbody tr {
                border-bottom: 1px solid #dfe9e7;
                padding: 0.45rem 0;
            }

                .log-table tbody tr:last-child {
                    border-bottom: 0;
                }

            .log-table tbody td {
                border-bottom: 0;
                padding: 0.55rem 1rem;
            }

                .log-table tbody td::before {
                    color: #72817e;
                    content: attr(data-label);
                    display: block;
                    font-size: 0.7rem;
                    font-weight: 700;
                    letter-spacing: 0.035em;
                    margin-bottom: 0.2rem;
                    text-transform: uppercase;
                }

            .log-table tbody tr.patient-admitted td:first-child,
            .log-table tbody tr.patient-discharged td:first-child {
                border-left-width: 4px;
            }
    }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">All Patients</h1>
        <p class="page-subtitle text-muted">All registered patients and admission status, grouped by ward.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Index">Return to dashboard</a>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/History">See admission history</a>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <label class="col-form-label fw-semibold">Patient status</label>
    </div>
    <div class="col-auto">
        <select name="StatusFilter" class="form-select form-select-sm" onchange="this.form.submit()" asp-items="Model.StatusOptions" asp-for="StatusFilter">
        </select>
    </div>
</form>

@if (Model.Patients.Count == 0)
{
    <div class="empty-panel">
        <p class="text-muted mb-0">No patients match this filter.</p>
    </div>
}
else
{
    @foreach (var wardGroup in Model.PatientsByWard)
    {
        var isUnassigned = wardGroup.Key == -1;
        var wardName = !isUnassigned && Model.WardsById.TryGetValue(wardGroup.Key, out var wardLookup)
            ? wardLookup.WardName
            : "Unassigned";
        var collapseId = "ward-" + (isUnassigned ? "unassigned" : wardGroup.Key.ToString());

        <div class="ward-group app-card">
            <button class="ward-group-header" type="button" data-bs-toggle="collapse"
                    data-bs-target="#@collapseId" aria-expanded="true" aria-controls="@collapseId">
                <span>
                    @wardName
                    @if (!isUnassigned && Model.WardsById.TryGetValue(wardGroup.Key, out var ward))
                    {
                        var isFull = ward.CurrentOccupancy >= ward.MaxCapacity;
                        <span class="ward-capacity @(isFull ? "ward-full" : "")">
                            (@ward.CurrentOccupancy/@ward.MaxCapacity beds@(isFull ? " — full" : ""))
                        </span>
                    }
                    else
                    {
                        <span class="ward-capacity">(@wardGroup.Count() patients)</span>
                    }
                </span>
                <i class="bi bi-chevron-right chevron"></i>
            </button>

            <div class="collapse show" id="@collapseId">
                <div class="table-responsive">
                    <table class="table log-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>Status</th>
                                <th>Medications</th>
                                <th>Admitted</th>
                                <th>Discharged</th>
                                <th>Nurse Call</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in wardGroup)
                            {
                                <tr class="@(patient.IsDischarged ? "patient-discharged" : "patient-admitted")">
                                    <td data-label="Patient" class="fw-medium">@patient.PatientName</td>
                                    <td data-label="Status">
                                        <span class="badge @(patient.IsDischarged ? "bg-secondary" : "bg-success")">
                                            @patient.Status
                                        </span>
                                    </td>
                                    <td data-label="Medications" class="text-muted small">@patient.MedicationsSummary</td>
                                    <td data-label="Admitted">@(patient.AdmissionDateTime?.ToLocalTime().ToString("g") ?? "—")</td>
                                    <td data-label="Discharged">@(patient.DischargeDateTime?.ToLocalTime().ToString("g") ?? "—")</td>
                                    <td data-label="Nurse Call">
                                        @if (patient.RequestHelp)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td data-label="Actions" class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@patient.PatientId">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
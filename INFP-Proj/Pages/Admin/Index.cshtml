@page
@model INFP_Proj.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Patient List";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Patient list</h1>
        <p class="page-subtitle text-muted">All registered patients and admission status.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Dashboard">Dashboard</a>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Logs">Activity log</a>
        <a class="btn btn-primary btn-sm" asp-page="Create">Add patient</a>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (Model.Patients.Count == 0)
{
    <div class="empty-state">
        <p class="text-muted mb-3">No patients registered yet.</p>
        <a class="btn btn-primary" asp-page="Create">Add new patient</a>
    </div>
}
else
{
    <div class="app-table-wrapper table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Status</th>
                    <th>Medications</th>
                    <th>Admitted</th>
                    <th>Discharged</th>
                    <th>Nurse Call</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in Model.Patients)
                {
                    <tr>
                        <td class="fw-medium">@patient.PatientName</td>
                        <td>
                            <span class="badge @(patient.IsDischarged ? "bg-secondary" : "bg-success")">
                                @patient.Status
                            </span>
                        </td>
                        <td class="text-muted small">@patient.MedicationsSummary</td>
                        <td>@(patient.AdmissionDateTime?.ToLocalTime().ToString("g") ?? "—")</td>
                        <td>@(patient.DischargeDateTime?.ToLocalTime().ToString("g") ?? "—")</td>
                        <td>
                            @if (patient.NurseCall)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@patient.PatientId">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

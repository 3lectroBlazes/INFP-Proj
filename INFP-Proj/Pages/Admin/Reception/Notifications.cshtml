@page
@model INFP_Proj.Pages.Admin.Reception.ManageNotificationsModel
@{
    ViewData["Title"] = "Email Notifications Dashboard";
}

<style>
    .notify-card {
        border: 1px solid #dfe9e7;
        border-radius: 15px;
        overflow: hidden;
    }

        .notify-card .card-header {
            background: #ffffff;
            border-bottom: 1px solid #edf2f1;
            font-weight: 700;
            padding: 1rem 1.2rem;
        }

        .notify-card .card-body {
            padding: 1.2rem;
        }

        .notify-card.notify-primary {
            border-top: 4px solid #0b5f6b;
        }

        .notify-card.notify-warning {
            border-top: 4px solid #d97706;
        }

        .notify-card.notify-danger {
            border-top: 4px solid #dc3545;
        }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Communication &amp; alerts center</h1>
        <p class="page-subtitle text-muted">Send email notifications to patients, families, and staff.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Index">Return to dashboard</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="notify-card notify-primary app-card card h-100">
            <div class="card-header">
                <i class="bi bi-person-lines-fill text-primary me-2"></i>Patient/Family Updates
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="PatientAlert">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Select Patient</label>
                        <select name="targetUserId" asp-items="Model.PatientList" class="form-select" required>
                            <option value="">-- Choose Patient --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Update Type</label>
                        <select name="messageType" class="form-select" required>
                            <option value="Surgery Update">Surgery Update</option>
                            <option value="Appointment Reminder">Appointment Reminder</option>
                            <option value="Discharge Notice">Discharge Notice</option>
                            <option value="General Info">General Info</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Custom Message</label>
                        <textarea name="customMessage" class="form-control" rows="3" required placeholder="Enter email text..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Send Patient Email</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="notify-card notify-warning app-card card h-100">
            <div class="card-header">
                <i class="bi bi-smartwatch text-warning me-2"></i>Bracelet Hardware Alert
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="HardwareAlert">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Target Nurse</label>
                        <select name="targetNurseId" asp-items="Model.NurseList" class="form-select" required>
                            <option value="">-- Notify Which Nurse? --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Faulty Bracelet</label>
                        <select name="braceletId" asp-items="Model.BraceletList" class="form-select" required>
                            <option value="">-- Select Bracelet --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Issue Description</label>
                        <textarea name="issueDescription" class="form-control" rows="3" required placeholder="e.g., Low battery, sensor offline, strap broken..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-warning w-100 fw-bold">Notify Nurse via Email</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="notify-card notify-danger app-card card h-100">
            <div class="card-header">
                <i class="bi bi-exclamation-octagon-fill text-danger me-2"></i>Emergency Broadcast
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="EmergencyAlert">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Target Group</label>
                        <select name="targetGroup" class="form-select" required>
                            <option value="Doctors">Doctors Only</option>
                            <option value="Nurses">Nurses Only</option>
                            <option value="Both">All Medical Staff (Both)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Emergency Type</label>
                        <select name="emergencyType" class="form-select" required>
                            <option value="Code Blue (Cardiac Arrest)">Code Blue</option>
                            <option value="Fall Alert">Fall Alert</option>
                            <option value="Security Incident">Security Incident</option>
                            <option value="Evacuation">Evacuation</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Location / Details</label>
                        <textarea name="locationDetails" class="form-control" rows="3" required placeholder="e.g., Ward 2, Bed 12. Patient unresponsive."></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger w-100 fw-bold">BROADCAST EMERGENCY EMAIL</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (TempData["AlertMessage"] != null)
    {
        <script>
            // Ensure the string is safely escaped for JavaScript
            var alertText = @Json.Serialize(TempData["AlertMessage"]?.ToString());
            window.alert(alertText);
        </script>
    }
}

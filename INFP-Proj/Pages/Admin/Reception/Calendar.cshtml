@page
@model INFP_Proj.Pages.Admin.Reception.CalendarModel
@{
    ViewData["Title"] = "Appointments Calendar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-calendar-week"></i> Appointments Calendar</h2>

        <button class="btn btn-success fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addModal">
            <i class="bi bi-plus-lg me-1"></i> Add Appointment
        </button>
    </div>
    <hr />

    <div id="calendar" class="bg-white p-3 shadow-sm rounded"></div>
</div>

<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-top border-success border-4">
            <div class="modal-header">
                <h5 class="modal-title">Add New Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Patient ID</label>
                        <select id="addPatientId" class="form-select" asp-items="Model.PatientsList" required>
                            <option value="">-- Search by Name or ID --</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Date</label>
                            <input type="date" class="form-control" id="addDate" min="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Time</label>
                            <select class="form-select" id="addTime" asp-items="Model.TimeSlots" required>
                                <option value="">-- Select Time --</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Reason</label>
                        <input type="text" class="form-control" id="addReason" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Urgency</label>
                        <select class="form-select" id="addUrgency">
                            <option value="Normal">Normal</option>
                            <option value="Urgent">Urgent</option>
                            <option value="Emergency">Emergency</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="btnSubmitAdd">Save Appointment</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="actionModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content text-center">
            <div class="modal-header bg-light">
                <h5 class="modal-title w-100">Manage Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <p class="text-muted small mb-4">Choose an action for this appointment.</p>

                <!-- ADDED: Show patient request information -->
                <div id="patientRequestInfo" class="alert alert-warning small" style="display:none;"></div>

                <!-- ADDED: Accept/Reject patient request -->
                <div id="patientRequestActions" style="display:none;">
                    <button type="button" class="btn btn-success w-100 mb-2" id="btnAcceptAppointment">
                        Accept
                    </button>
                    <button type="button" class="btn btn-outline-danger w-100 mb-2" id="btnRejectAppointment">
                        Reject
                    </button>
                </div>

                <button type="button" class="btn btn-primary w-100 mb-2" id="btnGoToUpdate">
                    <i class="bi bi-pencil-square me-2"></i> Update Form
                </button>
                <button type="button" class="btn btn-danger w-100" id="btnGoToDelete">
                    <i class="bi bi-trash me-2"></i> Delete Appointment
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="updateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-top border-primary border-4">
            <div class="modal-header">
                <h5 class="modal-title">Update Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="updateForm">
                    <input type="hidden" id="updateApptId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Patient ID</label>
                        <select id="updatePatientId" class="form-select" asp-items="Model.PatientsList" required>
                            <option value="">-- Search by Name or ID --</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Date</label>
                            <input type="date" class="form-control" id="updateDate" min="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Time</label>
                            <select class="form-select" id="updateTime" asp-items="Model.TimeSlots" required>
                                <option value="">-- Select Time --</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Reason</label>
                        <input type="text" class="form-control" id="updateReason" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Urgency</label>
                        <select class="form-select" id="updateUrgency">
                            <option value="Normal">Normal</option>
                            <option value="Urgent">Urgent</option>
                            <option value="Emergency">Emergency</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSubmitUpdate">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>

    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            var addModal = new bootstrap.Modal(document.getElementById('addModal'));
            var actionModal = new bootstrap.Modal(document.getElementById('actionModal'));
            var updateModal = new bootstrap.Modal(document.getElementById('updateModal'));

            var currentEventData = null;

            var addPatientSelect = new TomSelect("#addPatientId", {
                create: false,
                sortField: { field: "text", direction: "asc" }
            });

            var updatePatientSelect = new TomSelect("#updatePatientId", {
                create: false,
                sortField: { field: "text", direction: "asc" }
            });

            function getFormattedDateTime(dateObj) {
                let year = dateObj.getFullYear();
                let month = String(dateObj.getMonth() + 1).padStart(2, '0');
                let day = String(dateObj.getDate()).padStart(2, '0');
                let hours = String(dateObj.getHours()).padStart(2, '0');
                let minutes = String(dateObj.getMinutes()).padStart(2, '0');
                return {
                    date: `${year}-${month}-${day}`,
                    time: `${hours}:${minutes}`
                };
            }

            let todayFormatted = getFormattedDateTime(new Date()).date;
            document.getElementById('addDate').setAttribute('min', todayFormatted);
            document.getElementById('updateDate').setAttribute('min', todayFormatted);

            function filterAvailableTimes(dateVal, timeSelectId, ignoreEventId = null) {
                let timeSelect = document.getElementById(timeSelectId);
                if (!timeSelect || !dateVal) return;

                let allEvents = calendar.getEvents();
                let bookedTimes = [];
                let currentEventOrigTime = null;

                allEvents.forEach(evt => {
                    if (!evt.start) return;

                    let evtFormatted = getFormattedDateTime(evt.start);
                    if (ignoreEventId && evt.id == ignoreEventId) {
                        if (evtFormatted.date === dateVal) {
                            currentEventOrigTime = evtFormatted.time;
                        }
                        return;
                    }

                    if (evtFormatted.date === dateVal) {
                        bookedTimes.push(evtFormatted.time);
                    }
                });

                let now = new Date();
                let isToday = (dateVal === getFormattedDateTime(now).date);
                let currentHour = now.getHours();
                let currentMinute = now.getMinutes();

                let options = timeSelect.options;
                for (let i = 0; i < options.length; i++) {
                    let opt = options[i];
                    if (opt.value === "") continue;

                    let isBooked = bookedTimes.includes(opt.value);
                    let isPastTime = false;

                    if (isToday) {
                        let [optHour, optMin] = opt.value.split(':').map(Number);
                        if (optHour < currentHour || (optHour === currentHour && optMin < currentMinute)) {
                            if (opt.value !== currentEventOrigTime) {
                                isPastTime = true;
                            }
                        }
                    }

                    if (isBooked || isPastTime) {
                        opt.hidden = true;
                        opt.disabled = true;
                        opt.style.display = 'none';
                    } else {
                        opt.hidden = false;
                        opt.disabled = false;
                        opt.style.display = '';
                    }
                }

                if (timeSelect.selectedIndex >= 0 && timeSelect.options[timeSelect.selectedIndex].disabled) {
                    timeSelect.value = "";
                }
            }

            document.getElementById('addModal').addEventListener('show.bs.modal', function (e) {
                if (e.relatedTarget) {
                    document.getElementById('addForm').reset();
                    if (typeof addPatientSelect !== 'undefined') addPatientSelect.clear();

                    let timeSelect = document.getElementById('addTime');
                    for (let i = 0; i < timeSelect.options.length; i++) {
                        timeSelect.options[i].hidden = false;
                        timeSelect.options[i].disabled = false;
                        timeSelect.options[i].style.display = '';
                    }
                }
            });

            ['change', 'input'].forEach(evtType => {
                document.getElementById('addDate').addEventListener(evtType, function(e) {
                    filterAvailableTimes(e.target.value, 'addTime');
                });

                document.getElementById('updateDate').addEventListener(evtType, function(e) {
                    let currentApptId = document.getElementById('updateApptId').value;
                    filterAvailableTimes(e.target.value, 'updateTime', currentApptId);
                });
            });

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                height: "auto",
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                slotMinTime: '09:00:00',
                slotMaxTime: '18:00:00',
                slotDuration: '01:00:00',
                businessHours: {
                    startTime: '09:00',
                    endTime: '18:00'
                },
                events: '?handler=FetchAppointments',
                selectable: true,

                // ADDED: Highlight patient appointment and reschedule requests
                eventDidMount: function(info) {
                    let p = info.event.extendedProps;

                    if (p.hasPendingChange) {
                        info.el.style.backgroundColor = '#fd7e14';
                    }
                    else if (!p.docAcknowledged && p.patientAcknowledged && p.status === "Pending") {
                        info.el.style.backgroundColor = '#ffc107';
                        info.el.style.color = '#000';
                    }
                },

                dateClick: function(info) {
                    let now = new Date();

                    if (info.date.setHours(0,0,0,0) < now.setHours(0,0,0,0)) {
                        alert("Appointments cannot be scheduled in the past.");
                        return;
                    }

                    let hour = info.date.getHours();
                    if (hour >= 18) {
                        alert("Appointments cannot be scheduled after the 5:00 PM slot.");
                        return;
                    }

                    document.getElementById('addForm').reset();
                    addPatientSelect.clear();

                    let formatted = getFormattedDateTime(info.date);
                    document.getElementById('addDate').value = formatted.date;

                    filterAvailableTimes(formatted.date, 'addTime');

                    let timeSelect = document.getElementById('addTime');
                    let targetOption = Array.from(timeSelect.options).find(opt => opt.value === formatted.time);
                    if (targetOption && !targetOption.disabled) {
                        timeSelect.value = formatted.time;
                    } else {
                        timeSelect.value = "";
                    }

                    addModal.show();
                },

                eventClick: function(info) {
                    currentEventData = info.event;

                    // ADDED: Show approval buttons for patient request/reschedule
                    let p = currentEventData.extendedProps;
                    let patientRequest = !p.docAcknowledged && p.patientAcknowledged && p.status === "Pending";
                    let needsAction = patientRequest || p.hasPendingChange;

                    document.getElementById('patientRequestActions').style.display = needsAction ? 'block' : 'none';

                    let infoBox = document.getElementById('patientRequestInfo');

                    if (p.hasPendingChange) {
                        infoBox.innerText = "Requested new date: " + new Date(p.requestedDateTime).toLocaleString();
                        infoBox.style.display = 'block';
                    }
                    else if (patientRequest) {
                        infoBox.innerText = "Patient-created appointment request";
                        infoBox.style.display = 'block';
                    }
                    else {
                        infoBox.style.display = 'none';
                    }

                    actionModal.show();
                }
            });

            calendar.render();

            document.getElementById('btnSubmitAdd').addEventListener('click', function() {
                let dateVal = document.getElementById('addDate').value;
                let timeVal = document.getElementById('addTime').value;
                let patientVal = document.getElementById('addPatientId').value;
                let reasonVal = document.getElementById('addReason').value;

                if (!dateVal || !timeVal || !patientVal || !reasonVal) {
                    alert("Please fill out all required fields.");
                    return;
                }

                let selectedDateTime = new Date(dateVal + 'T' + timeVal + ':00');
                if (selectedDateTime < new Date()) {
                    alert("Appointments cannot be scheduled in the past.");
                    return;
                }

                let data = {
                    AppointmentRequestID: 0,
                    PatientID: parseInt(patientVal),
                    Reason: reasonVal,
                    DateTime: dateVal + 'T' + timeVal + ':00',
                    Urgency: document.getElementById('addUrgency').value
                };

                fetch(`?handler=Add`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(data)
                }).then(res => res.json()).then(data => {
                    if(data.success) {
                        addModal.hide();
                        document.getElementById('addForm').reset();
                        if (typeof addPatientSelect !== 'undefined') addPatientSelect.clear();
                        calendar.refetchEvents();
                    } else {
                        alert(data.message || 'Error adding appointment.');
                    }
                }).catch(err => {
                    console.error(err);
                    alert('A network error occurred.');
                });
            });

            document.getElementById('btnGoToUpdate').addEventListener('click', function() {
                actionModal.hide();

                document.getElementById('updateApptId').value = currentEventData.id;
                document.getElementById('updateReason').value = currentEventData.title;
                document.getElementById('updateUrgency').value = currentEventData.extendedProps.urgency;
                updatePatientSelect.setValue(currentEventData.extendedProps.patientId);

                let eventDate = currentEventData.start;
                let formatted = getFormattedDateTime(eventDate);
                document.getElementById('updateDate').value = formatted.date;

                filterAvailableTimes(formatted.date, 'updateTime', currentEventData.id);

                document.getElementById('updateTime').value = formatted.time;
                updateModal.show();
            });

            document.getElementById('btnSubmitUpdate').addEventListener('click', function() {
                let dateVal = document.getElementById('updateDate').value;
                let timeVal = document.getElementById('updateTime').value;
                let patientVal = document.getElementById('updatePatientId').value;
                let reasonVal = document.getElementById('updateReason').value;

                if (!dateVal || !timeVal || !patientVal || !reasonVal) {
                    alert("Please fill out all required fields.");
                    return;
                }

                let selectedDateTime = new Date(dateVal + 'T' + timeVal + ':00');
                let originalDateTime = currentEventData.start;

                if (selectedDateTime < new Date() && selectedDateTime.getTime() !== originalDateTime.getTime()) {
                    alert("Appointments cannot be rescheduled to a past date/time.");
                    return;
                }

                let data = {
                    AppointmentRequestID: parseInt(document.getElementById('updateApptId').value),
                    PatientID: parseInt(patientVal),
                    Reason: reasonVal,
                    DateTime: dateVal + 'T' + timeVal + ':00',
                    Urgency: document.getElementById('updateUrgency').value
                };

                fetch(`?handler=Update`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(data)
                }).then(res => res.json()).then(data => {
                    if(data.success) {
                        updateModal.hide();
                        calendar.refetchEvents();
                    } else {
                        alert(data.message || 'Error updating appointment.');
                    }
                }).catch(err => {
                    console.error(err);
                    alert('A network error occurred.');
                });
            });

            // ADDED: Reception accepts patient appointment/reschedule
            document.getElementById('btnAcceptAppointment').addEventListener('click', function() {
                let id = parseInt(currentEventData.id);

                fetch('?handler=Accept', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(id)
                }).then(res => res.json()).then(data => {
                    if(data.success) {
                        actionModal.hide();
                        calendar.refetchEvents();
                    } else {
                        alert(data.message || 'Error accepting request.');
                    }
                });
            });

            // ADDED: Reception rejects patient appointment/reschedule
            document.getElementById('btnRejectAppointment').addEventListener('click', function() {
                if(!confirm("Reject this request?")) return;

                let id = parseInt(currentEventData.id);

                fetch('?handler=Reject', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(id)
                }).then(res => res.json()).then(data => {
                    if(data.success) {
                        actionModal.hide();
                        calendar.refetchEvents();
                    } else {
                        alert(data.message || 'Error rejecting request.');
                    }
                });
            });

            document.getElementById('btnGoToDelete').addEventListener('click', function() {
                if(!confirm("Are you sure you want to permanently delete this appointment?")) return;

                let id = parseInt(currentEventData.id);

                fetch('?handler=Delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(id)
                }).then(res => res.json()).then(data => {
                    if(data.success) {
                        actionModal.hide();
                        calendar.refetchEvents();
                    }
                    else {
                        alert('Error deleting appointment.');
                    }
                });
            });
        });
    </script>
}
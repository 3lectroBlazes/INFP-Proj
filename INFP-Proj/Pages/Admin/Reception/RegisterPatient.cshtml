@page
@model INFP_Proj.Pages.Admin.Reception.RegisterPatientModel
@{
    ViewData["Title"] = "Register New Patient";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Patient Registration & Assignment</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <label class="form-label fw-bold d-block">Patient type</label>
                                <div class="btn-group" role="group" aria-label="Registration mode">
                                    <input type="radio" class="btn-check" name="Input.Mode" id="modeNew" value="New" autocomplete="off" checked="@(Model.Input.Mode != "Existing")">
                                    <label class="btn btn-outline-primary" for="modeNew">Register New Patient</label>

                                    <input type="radio" class="btn-check" name="Input.Mode" id="modeExisting" value="Existing" autocomplete="off" checked="@(Model.Input.Mode == "Existing")">
                                    <label class="btn btn-outline-primary" for="modeExisting">Already Registered User</label>
                                </div>
                            </div>
                        </div>

                        <div id="newPatientFields" class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="Input.FirstName" class="form-label fw-bold"></label>
                                <input asp-for="Input.FirstName" class="form-control" />
                                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.LastName" class="form-label fw-bold"></label>
                                <input asp-for="Input.LastName" class="form-control" />
                                <span asp-validation-for="Input.LastName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.Email" class="form-label fw-bold"></label>
                                <input asp-for="Input.Email" class="form-control" placeholder="patient@example.com" />
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div id="existingPatientFields" class="row mb-4">
                            <div class="col-md-12">
                                <label asp-for="Input.ExistingUserId" class="form-label fw-bold"></label>
                                <select asp-for="Input.ExistingUserId" asp-items="Model.EligibleExistingUsers" class="form-select">
                                    <option value="">-- Select a registered user --</option>
                                </select>
                                <span asp-validation-for="Input.ExistingUserId" class="text-danger"></span>
                                <p class="form-text text-muted mb-0">Non-admin users who are not currently admitted (discharged patients can be readmitted).</p>
                            </div>
                        </div>

                        <hr />
                        <h5 class="mb-3 text-secondary">Assignment Details</h5>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="SelectedWardID" class="form-label fw-bold text-info">Select Ward (Required for Bed Selection)</label>
                                <select asp-for="SelectedWardID" asp-items="Model.AvailableWards" class="form-select border-info" id="wardSelect">
                                    <option value="">-- Choose a Ward --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.BraceletID" class="form-label fw-bold text-primary"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-list-check"></i></span>
                                    <select asp-for="Input.BraceletID" asp-items="Model.AvailableBracelets" class="form-select border-primary">
                                        <option value="">-- Select an Available Bracelet --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Input.BraceletID" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.BedID" class="form-label fw-bold text-success"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-hospital"></i></span>
                                    <select asp-for="Input.BedID" asp-items="Model.AvailableBeds" class="form-select border-success" id="bedSelect" disabled="@(Model.SelectedWardID == null ? "disabled" : null)">
                                        <option value="">-- Select an Available Bed --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Input.BedID" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="Input.DiagnosisID" class="form-label fw-bold"></label>
                                <select asp-for="Input.DiagnosisID" asp-items="Model.AvailableDiagnoses" class="form-select">
                                    <option value="">-- Select a diagnosis --</option>
                                </select>
                                <span asp-validation-for="Input.DiagnosisID" class="text-danger"></span>
                                <p class="form-text text-muted mb-0">General diagnosis category for this admission.</p>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <label asp-for="Input.AdmissionNotes" class="form-label fw-bold"></label>
                                <textarea asp-for="Input.AdmissionNotes" class="form-control" rows="3" placeholder="Describe observations (e.g. spasming, shaking)..."></textarea>
                                <span asp-validation-for="Input.AdmissionNotes" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end border-top pt-3">
                            <a asp-page="/Index" class="btn btn-outline-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Register Patient</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const wardSelect = document.getElementById('wardSelect');
            const bedSelect = document.getElementById('bedSelect');

            wardSelect.addEventListener('change', function () {
                const wardId = this.value;

                bedSelect.innerHTML = '<option value="">-- Select an Available Bed --</option>';

                if (!wardId) {
                    bedSelect.disabled = true;
                    return;
                }

                fetch(`?handler=WardData&wardId=${wardId}`)
                    .then(response => {
                        if (!response.ok) throw new Error("Network response error");
                        return response.json();
                    })
                    .then(data => {
                        bedSelect.disabled = false;

                        data.beds.forEach(item => {
                            let option = new Option(item.text, item.value);
                            bedSelect.add(option);
                        });
                    })
                    .catch(error => {
                        console.error('Error fetching data:', error);
                        alert("Failed to load beds for the selected ward.");
                    });
            });

            const modeRadios = document.querySelectorAll('input[name="Input.Mode"]');
            const newFields = document.getElementById('newPatientFields');
            const existingFields = document.getElementById('existingPatientFields');

            function applyMode(mode) {
                const isExisting = mode === 'Existing';
                newFields.hidden = isExisting;
                existingFields.hidden = !isExisting;
            }

            modeRadios.forEach(function (radio) {
                radio.addEventListener('change', function () {
                    applyMode(radio.value);
                });
            });

            const checkedMode = document.querySelector('input[name="Input.Mode"]:checked');
            applyMode(checkedMode ? checkedMode.value : 'New');
        });
    </script>
}

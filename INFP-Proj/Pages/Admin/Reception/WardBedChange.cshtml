@page
@model INFP_Proj.Pages.Admin.Reception.WardBedChangeModel
@{
    ViewData["Title"] = "Manage Wards & Beds";
}

<div class="container mt-4 mb-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h3 class="mb-3 text-secondary"><i class="bi bi-bar-chart-fill me-2"></i>Live Capacity Dashboard</h3>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body py-2">
                    <h6 class="card-title mb-0 d-flex justify-content-between align-items-center">
                        Hospital Max Capacity
                        <img src="/images/capacity.png" width="50" height="50" />
                    </h6>
                    <h3 class="display-6 mb-0 fw-bold">@Model.TotalHospitalCapacity</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-danger shadow-sm">
                <div class="card-body py-2">
                    <h6 class="card-title mb-0 d-flex justify-content-between align-items-center">
                        Total Occupied Beds
                        <img src="/images/disability.png" width="50" height="50" />
                    </h6>
                    <h3 class="display-6 mb-0 fw-bold">@Model.TotalOccupied</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body py-2">
                    <h6 class="card-title mb-0 d-flex justify-content-between align-items-center">
                        Total Available Beds
                        <img src="/images/hospital-bed.png" width="50" height="50" />
                    </h6>
                    <h3 class="display-6 mb-0 fw-bold">@Model.TotalAvailable</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        @foreach (var ward in Model.WardStats)
        {
            string barColor = "bg-success";
            if (ward.OccupancyRate >= 90) barColor = "bg-danger";
            else if (ward.OccupancyRate >= 75) barColor = "bg-warning";

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-header bg-light fw-bold d-flex justify-content-between align-items-center py-2">
                        <span>@ward.WardName</span>
                        <span class="badge bg-secondary text-white">Ward @ward.WardID</span>
                    </div>
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">Occupied:</span>
                            <span class="fw-bold text-danger">@ward.OccupiedBeds</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Available:</span>
                            <span class="fw-bold text-success">@ward.AvailableBeds</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar @barColor" role="progressbar" style="width: @ward.OccupancyRate%"
                                 aria-valuenow="@ward.OccupancyRate" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="text-end mt-1">
                            <small class="text-muted" style="font-size: 0.75rem;">@Math.Round(ward.OccupancyRate, 1)% Full</small>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <hr class="mb-5 text-muted" />

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-light">
                    <h4 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i>Transfer Patient</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-4">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Input.PatientID" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                                    <select asp-for="Input.PatientID" asp-items="Model.AdmittedPatients" class="form-select">
                                        <option value="">-- Select an Admitted Patient --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Input.PatientID" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Input.NewBedID" class="form-label fw-bold text-success"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-hospital"></i></span>
                                    <select asp-for="Input.NewBedID" asp-items="Model.AvailableBeds" class="form-select border-success">
                                        <option value="">-- Select a New Destination Bed --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Input.NewBedID" class="text-danger"></span>
                                <div class="form-text">The patient's active records will automatically update to reflect the new Ward and Bed.</div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end border-top pt-3">
                            <a asp-page="/Index" class="btn btn-outline-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-warning px-4 text-dark fw-bold">Transfer Patient</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
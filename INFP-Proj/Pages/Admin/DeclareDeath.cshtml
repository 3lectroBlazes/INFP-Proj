@page
@model INFP_Proj.Pages.Admin.DeclareDeath
@{
    ViewData["Title"] = "Declare Death Record";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Cause of Death Record</h1>
        <p class="page-subtitle text-muted">
            NOTE: THIS IS NOT A GOVERNMENTAL PROPERTY. THIS DOCUMENT HAS NO LEGAL FORCE OR EFFECT, 
            CANNOT BE USED LEGALLY FOR ANY OFFICIAL PURPOSE, AND DOES NOT CONSTITUTE A REAL OR VALID 
            INSTRUMENT.
        </p>
    </div>
        <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Index">Return to dashboard</a>
    </div>
</div>

@if (Model.Patient != null)
{
    <div class="app-card card mb-4">
        <div class="card-body small">
            <strong>Patient:</strong>
            @(Model.Patient.User != null ? $"{Model.Patient.User.FirstName} {Model.Patient.User.LastName}" : $"Patient #{Model.Patient.PatientID}")
            &nbsp;|&nbsp; <strong>Patient ID:</strong> @Model.Patient.PatientID
            @if (Model.Record != null)
            {
                <text>&nbsp;|&nbsp; <strong>Admitted:</strong> @Model.Record.AdmissionDateTime.ToString("yyyy-MM-dd")</text>
            }
        </div>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="app-card card mb-4">
    <div class="card-header">Record details</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Generate">
            <input type="hidden" name="patientId" value="@Model.Patient?.PatientID" />
            <input type="hidden" name="recordId" value="@Model.Record?.RecordID" />

            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label for="Sex" class="form-label">Sex</label>
                    <select id="Sex" name="Sex" class="form-select" required>
                        <option value="" disabled selected>Select...</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="DateOfBirth" class="form-label">Date of Birth</label>
                    <input type="date" id="DateOfBirth" name="DateOfBirth" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label for="DateOfDeath" class="form-label">Date of Death</label>
                    <input type="date" id="DateOfDeath" name="DateOfDeath" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label for="TimeOfDeath" class="form-label">Time of Death</label>
                    <input type="time" id="TimeOfDeath" name="TimeOfDeath" class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label for="ConditionReason" class="form-label">Cause of Death / Clinical Notes</label>
                <textarea id="ConditionReason" name="ConditionReason" class="form-control" rows="4" required></textarea>
            </div>

            <button type="submit" class="btn btn-danger">DECLARE DEATH</button>
        </form>
    </div>
</div>
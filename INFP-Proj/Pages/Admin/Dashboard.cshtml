@page
@model INFP_Proj.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Staff Dashboard</h1>
        <p class="page-subtitle text-muted">Manage patients, vitals, and hospital activity.</p>
    </div>
</div>

<div class="dashboard-grid">
    <a class="dashboard-tile" asp-page="/Admin/Index">
        <span class="dashboard-tile-title">Patient list</span>
        <p class="dashboard-tile-desc">View, edit, and register patients.</p>
    </a>
    <a class="dashboard-tile" asp-page="/Admin/Tracker">
        <span class="dashboard-tile-title">Vitals tracker</span>
        <p class="dashboard-tile-desc">Charts for heart rate, breathing, blood pressure, and temperature.</p>
    </a>
    <a class="dashboard-tile" asp-page="/Admin/Logs">
        <span class="dashboard-tile-title">Activity log</span>
        <p class="dashboard-tile-desc">Review system events with timestamps.</p>
    </a>
</div>

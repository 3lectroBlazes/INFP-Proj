@page
@model INFP_Proj.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<style>
    .dashboard-hero {
        background: linear-gradient(135deg, #087f73, #0a9b8c);
        color: white;
        border-radius: 18px;
        padding: 1.75rem;
    }

        .dashboard-hero p {
            color: rgba(255, 255, 255, 0.85);
        }

    .dashboard-card {
        border: 1px solid #dfe9e7;
        border-radius: 14px;
        overflow: hidden;
        height: 100%;
    }

        .dashboard-card .card-header {
            background: #ffffff;
            border-bottom: 1px solid #edf2f1;
            color: #006a72;
            font-weight: 700;
            padding: 1rem 1.15rem;
        }

    .section-heading {
        margin-bottom: 1rem;
    }

        .section-heading h2 {
            color: #173f3b;
            font-size: 1.25rem;
            margin-bottom: 0.25rem;
        }

    .quick-action {
        display: block;
        height: 100%;
        border: 1px solid #dfe9e7;
        border-radius: 14px;
        padding: 1.15rem;
        text-decoration: none;
        background: white;
        color: inherit;
        transition: 0.15s ease;
    }

        .quick-action:hover {
            transform: translateY(-2px);
            border-color: #8cc6bf;
            box-shadow: 0 0.5rem 1rem rgba(25, 75, 68, 0.08);
            color: inherit;
        }

    .quick-action-title {
        color: #006a72;
        font-weight: 700;
        margin-bottom: 0.3rem;
    }

    .empty-panel {
        background: #f8faf9;
        border: 1px dashed #cbd9d6;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
    }

    .staff-table thead th {
        background: #f1f8f7;
        border-bottom: 1px solid #d8e7e4;
        color: #47615d;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.035em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .staff-table tbody tr.active-emergency td:first-child {
        border-left: 4px solid #dc3545;
    }

    @@media (max-width: 767.98px) {
        .dashboard-hero {
            padding: 1.25rem;
        }
    }
</style>

<section class="dashboard-hero mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
            <div class="small text-uppercase fw-semibold mb-2">Staff portal</div>
            <h1 class="h3 mb-2">Staff dashboard</h1>
            <p class="mb-0">Manage patients, vitals, and hospital activity.</p>
        </div>

        @if (Model.EmergencyLogs.Count > 0)
        {
            <span class="badge rounded-pill px-3 py-2 bg-danger">
                @Model.EmergencyLogs.Count active @(Model.EmergencyLogs.Count == 1 ? "emergency" : "emergencies")
            </span>
        }
        else
        {
            <span class="badge rounded-pill px-3 py-2 bg-light text-success">No active emergencies</span>
        }
    </div>
</section>
<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Recent Patients</h5>
        <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Index">View all</a>
    </div>

    @if (Model.Patients.Count == 0)
    {
        <p class="text-muted small"> No patients registered yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Patient</th>
                        <th>Status</th>
                        <th>Medications</th>
                        <th>Nurse Call</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model.Patients.Take(5))  
                    {
                        <tr>
                            <td class="fw-medium">@patient.PatientName</td>
                            <td>
                                <span class="badge @(patient.IsDischarged ? "bg-secondary" : "bg-success")">
                                    @patient.Status
                                </span>
                            </td>
                            <td class="text-muted">@patient.MedicationsSummary</td>
                            <td>
                                @if (patient.NurseCall)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Edit" asp-route-id="@patient.PatientId">
                                    @if (User.IsInRole("Doctor"))
                                    {
                                        <text>Edit</text>
                                    }
                                    else
                                    {
                                        <text>View</text>
                                    }
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    </div>

<!-- Quick actions -->
<section class="mb-5">
    <div class="section-heading">
        <h2>Quick actions</h2>
        <p class="text-muted mb-0">Jump to another staff area.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <a class="quick-action" asp-page="/Admin/Index">
                <div class="quick-action-title">Patient list</div>
                <div class="small text-muted">View, edit, and register patients.</div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a class="quick-action" asp-page="/Admin/Tracker">
                <div class="quick-action-title">Vitals tracker</div>
                <div class="small text-muted">Charts for heart rate, breathing, and blood pressure.</div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a class="quick-action" asp-page="/Admin/Logs">
                <div class="quick-action-title">Activity log</div>
                <div class="small text-muted">Review system events with timestamps.</div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a class="quick-action" asp-page="/Admin/History">
                <div class="quick-action-title">Admission history</div>
                <div class="small text-muted">Browse all past and current admission records.</div>
            </a>
        </div>
    </div>
</section>

<!-- Doctor requests + Emergency logs -->
<section class="mb-4">
    <div class="section-heading">
        <h2>Needs attention</h2>
        <p class="text-muted mb-0">Pending doctor requests and unresolved emergencies.</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="dashboard-card app-card card">
                <div class="card-header d-flex justify-content-between align-items-center gap-2">
                    <span>Doctor requests</span>
                    <span class="badge bg-primary rounded-pill">@Model.DoctorRequests.Count pending</span>
                </div>

                <div class="card-body">
                    @if (Model.DoctorRequests.Count == 0)
                    {
                        <div class="empty-panel">
                            <p class="text-muted mb-0">No pending doctor requests.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table staff-table align-middle mb-0 small">
                                <thead>
                                    <tr>
                                        <th>Patient</th>
                                        <th>Request</th>
                                        <th class="text-nowrap">Requested</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.DoctorRequests)
                                    {
                                        <tr>
                                            <td class="fw-medium">@request.PatientName</td>
                                            <td class="text-muted">@request.RequestMessage</td>
                                            <td class="text-nowrap">
                                                <time datetime="@request.RequestDate.ToString("o")">
                                                    @request.RequestDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                                </time>
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Edit" asp-route-id="@request.PatientId">Open</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dashboard-card app-card card">
                <div class="card-header d-flex justify-content-between align-items-center gap-2">
                    <span>Emergency logs</span>
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Logs" asp-route-EmergencyFilter="yes">View all</a>
                </div>

                <div class="card-body">
                    @if (Model.EmergencyLogs.Count == 0)
                    {
                        <div class="empty-panel">
                            <p class="text-muted mb-0">No emergency events logged.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table staff-table align-middle mb-0 small">
                                <thead>
                                    <tr>
                                        <th class="text-nowrap">Timestamp</th>
                                        <th>User</th>
                                        <th>Event</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.EmergencyLogs)
                                    {
                                        <tr class="active-emergency">
                                            <td class="text-nowrap">
                                                <time datetime="@log.Timestamp.ToString("o")">
                                                    @log.Timestamp.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                                </time>
                                            </td>
                                            <td>@log.UserName</td>
                                            <td>@log.Event</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@page
@model INFP_Proj.Pages.Admin.TrackerModel
@{
    ViewData["Title"] = "Vitals Tracker";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Vitals tracker</h1>
        <p class="page-subtitle text-muted">Compare vitals across one or more patients.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Dashboard">Dashboard</a>
    </div>
</div>

<partial name="_AdminVitalsTracker" model="Model.ChartData" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/admin-vitals-tracker.js" asp-append-version="true"></script>
    <script src="~/js/admin-vitals-simulator.js" asp-append-version="true"></script>
}

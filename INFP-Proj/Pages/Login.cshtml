@page
@model INFP_Proj.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card">
            <h1>Sign in</h1>

            @if (!Model.RequiresOtp)
            {
                <p class="auth-lead">Access your hospital portal account.</p>

                <form method="post" asp-page-handler="Login">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="LModel.Email">Email address</label>
                        <input type="email" asp-for="LModel.Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="LModel.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="LModel.Password">Password</label>
                        <input type="password" asp-for="LModel.Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="LModel.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check d-flex justify-content-between align-items-center">
                        <span>
                            <input type="checkbox" asp-for="LModel.RememberMe" class="form-check-input" />
                            <label class="form-check-label" asp-for="LModel.RememberMe">Remember me</label>
                        </span>
                        <a asp-page="/ForgotPassword" class="text-primary small">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>

                <p class="text-center text-muted small mt-4 mb-0">
                    No account? <a asp-page="/Register" class="text-primary">Register</a>
                </p>
            }
            else
            {
                <p class="auth-lead">Enter the verification code sent to your email.</p>

                <form method="post" asp-page-handler="VerifyOtp">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-4">
                        <label class="form-label" asp-for="OtpCode">One-time code</label>
                        <input asp-for="OtpCode" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
                        <span asp-validation-for="OtpCode" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Verify and sign in</button>
                </form>

                <form method="post" asp-page-handler="Resend" class="mt-2">
                    <button type="submit" class="btn btn-link w-100 p-0">Resend code</button>
                </form>

                <p class="text-center text-muted small mt-3 mb-0">
                    <a asp-page="/Login" asp-page-handler="Reset" class="text-primary">Back to sign in</a>
                </p>
            }
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
</body>
</html>

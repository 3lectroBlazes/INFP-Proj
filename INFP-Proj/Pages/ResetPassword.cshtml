@page
@model INFP_Proj.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card">
            <h1>Reset password</h1>
            <p class="auth-lead">Choose a new password for your account.</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label" asp-for="RPModel.NewPassword">New password</label>
                    <input type="password" asp-for="RPModel.NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="RPModel.NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="RPModel.ConfirmPassword">Confirm password</label>
                    <input type="password" asp-for="RPModel.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="RPModel.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Reset password</button>
            </form>

            <p class="text-center text-muted small mt-4 mb-0">
                <a asp-page="/Login" class="text-primary">Back to sign in</a>
            </p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
</body>
</html>

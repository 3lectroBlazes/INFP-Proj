@page
@model INFP_Proj.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card">
            <h1>Forgot password</h1>
            <p class="auth-lead">Enter your account email and we'll send you a one-time code.</p>

            @if (Model.OtpSent)
            {
                <div class="alert alert-success py-2" role="alert">
                    A one-time code has been sent to your email address. It will expire in 10 minutes.
                </div>
            }
            else
            {
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="FPModel.Email">Email address</label>
                        <input type="email" asp-for="FPModel.Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="FPModel.Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Send reset code</button>
                </form>
            }

            <p class="text-center text-muted small mt-4 mb-0">
                <a asp-page="/Login" class="text-primary">Back to sign in</a>
            </p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
</body>
</html>

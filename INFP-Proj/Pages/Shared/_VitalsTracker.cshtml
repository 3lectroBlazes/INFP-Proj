@using INFP_Proj.ViewModel
@model VitalsChartViewModel

@if (Model.ShowPatientSelector && Model.Patients.Count > 0)
{
    <div class="app-card card mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-6 col-lg-4">
                    <label for="patientId" class="form-label">Select patient</label>
                    <select id="patientId" name="patientId" class="form-select" onchange="this.form.submit()">
                        @foreach (var patient in Model.Patients)
                        {
                            if (patient.PatientId == Model.PatientId)
                            {
                                <option value="@patient.PatientId" selected="selected">@patient.DisplayName</option>
                            }
                            else
                            {
                                <option value="@patient.PatientId">@patient.DisplayName</option>
                            }
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>
}

<p class="text-muted mb-4">Showing vitals for <strong class="text-dark">@Model.PatientName</strong></p>

@if (Model.Labels.Count == 0)
{
    <div class="alert alert-info">No vitals recorded for this patient yet.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="app-card card h-100">
                <div class="card-body">
                    <h2 class="h6 text-primary mb-3">Heart rate (bpm)</h2>
                    <div class="vitals-chart-container">
                        <canvas id="heartRateChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="app-card card h-100">
                <div class="card-body">
                    <h2 class="h6 text-primary mb-3">Breathing rate (breaths/min)</h2>
                    <div class="vitals-chart-container">
                        <canvas id="breathingRateChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="app-card card h-100">
                <div class="card-body">
                    <h2 class="h6 text-primary mb-3">Blood pressure (mmHg)</h2>
                    <div class="vitals-chart-container">
                        <canvas id="bloodPressureChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="app-card card h-100">
                <div class="card-body">
                    <h2 class="h6 text-primary mb-3">Temperature (°C)</h2>
                    <div class="vitals-chart-container">
                        <canvas id="temperatureChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="vitals-chart-data">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        }))
    </script>
}

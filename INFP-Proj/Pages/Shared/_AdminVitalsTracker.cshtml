@using INFP_Proj.ViewModel
@model AdminVitalsChartViewModel

<div class="patient-summary mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-12">
            <label for="patientIds" class="form-label fw-semibold">Select patients</label>
            <p class="text-muted small mb-2">Hold Ctrl (Windows) or Cmd (Mac) to select multiple patients. Compare vitals on the charts below.</p>
            @if (Model.Patients.Count == 0)
            {
                <p class="text-muted mb-0">No patients available. Add patients from the patient list first.</p>
            }
            else
            {
                <select id="patientIds" name="patientIds" class="form-select" multiple size="@Math.Min(8, Math.Max(4, Model.Patients.Count))">
                    @foreach (var patient in Model.Patients)
                    {
                        if (Model.SelectedPatientIds.Contains(patient.PatientId))
                        {
                            <option value="@patient.PatientId" selected="selected">@patient.DisplayName</option>
                        }
                        else
                        {
                            <option value="@patient.PatientId">@patient.DisplayName</option>
                        }
                    }
                </select>
            }
        </div>
        @if (Model.Patients.Count > 0)
        {
            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Apply selection</button>
                <a class="btn btn-outline-secondary" asp-page="/Admin/Tracker">Clear selection</a>
            </div>
        }
    </form>
</div>

@if (Model.SelectedPatientIds.Count > 0)
{
    <p class="text-muted mb-4">
        Showing vitals for:
        <strong class="text-dark">@string.Join(", ", Model.Series.Select(s => s.PatientName))</strong>
    </p>
}

@if (Model.SelectedPatientIds.Count == 1)
{
    @{
        var simulationVitals = new[]
        {
            new { Title = "Heart rate", Vital = "HeartRate" },
            new { Title = "Breathing rate", Vital = "RespiratoryRate" },
            new { Title = "Systolic pressure", Vital = "SystolicBloodPressure" },
            new { Title = "Diastolic pressure", Vital = "DiastolicBloodPressure" }
        };
    }

    <div class="simulation-note mb-4">
        <strong>Test controls</strong>
        <div class="small text-muted mt-1">
            Spike creates a reading above the safe range. Dip creates a reading below the safe range.
            Stable creates a reading within the safe range. Spike and Dip also create an emergency log and
            attempt to notify linked caretakers.
        </div>
    </div>

    <div class="row g-4 mb-4">
        @foreach (var simulationVital in simulationVitals)
        {
            <div class="col-md-6 col-xl-3">
                <div class="vital-card h-100">
                    <div class="card-body">
                        <div class="vital-header">
                            <h2 class="vital-title">@simulationVital.Title</h2>
                        </div>

                        <div class="small fw-semibold mb-2">Create test reading</div>

                        <form method="post" asp-page-handler="SimulateVital">
                            <input type="hidden" name="patientId" value="@Model.SelectedPatientIds[0]" />
                            <input type="hidden" name="vital" value="@simulationVital.Vital" />

                            <div class="simulation-buttons">
                                <button type="submit" name="direction" value="Spike" class="btn btn-outline-danger">Spike</button>
                                <button type="submit" name="direction" value="Dip" class="btn btn-outline-warning">Dip</button>
                                <button type="submit" name="direction" value="Stable" class="btn btn-outline-success">Stable</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (Model.Patients.Count > 0)
{
    <div class="simulation-note mb-4">Select exactly one patient above to simulate vitals.</div>
}

@if (Model.Series.Count == 0 || Model.Labels.Count == 0)
{
    <div class="alert alert-info">No vitals recorded for the selected patient(s) yet.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="vital-card h-100">
                <div class="card-body">
                    <div class="vital-header">
                        <h2 class="vital-title">Heart rate (bpm)</h2>
                    </div>
                    <div class="vitals-chart-container">
                        <canvas id="heartRateChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="vital-card h-100">
                <div class="card-body">
                    <div class="vital-header">
                        <h2 class="vital-title">Breathing rate (breaths/min)</h2>
                    </div>
                    <div class="vitals-chart-container">
                        <canvas id="breathingRateChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="vital-card h-100">
                <div class="card-body">
                    <div class="vital-header">
                        <h2 class="vital-title">Systolic blood pressure (mmHg)</h2>
                    </div>
                    <div class="vitals-chart-container">
                        <canvas id="systolicBloodPressureChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="vital-card h-100">
                <div class="card-body">
                    <div class="vital-header">
                        <h2 class="vital-title">Diastolic blood pressure (mmHg)</h2>
                    </div>
                    <div class="vitals-chart-container">
                        <canvas id="diastolicBloodPressureChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="admin-vitals-chart-data">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        }))
    </script>
}

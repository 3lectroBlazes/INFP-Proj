@using Microsoft.AspNetCore.Identity
@using INFP_Proj.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/INFP_Proj.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-light navbar-expand-xl app-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Hospital Portal</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.FindFirst("IsAdmin")?.Value == "True")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Admin/Index">Home</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="navPatients" role="button" data-bs-toggle="dropdown" aria-expanded="false">Patients</a>
                                    <ul class="dropdown-menu" aria-labelledby="navPatients">
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/PatientList">Patients</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/History">Admissions</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Tracker">Vitals</a></li>
                                        @if (User.IsInRole("Reception"))
                                        {
                                            <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Reception/RegisterPatient">Register Patients</a></li>
                                            <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Reception/Calendar">Calendar</a></li>
                                        }
                                    </ul>
                                </li>
                                @if (User.IsInRole("Reception"))
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="navWards" role="button" data-bs-toggle="dropdown" aria-expanded="false">Reception</a>
                                        <ul class="dropdown-menu" aria-labelledby="navWards">
                                            <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Reception/WardBedChange">Wards and Beds</a></li>
                                            <li>
                                                <a class="dropdown-item" asp-area="" asp-page="/Admin/Reception/Notifications">Send Notifications</a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-area="" asp-page="/Admin/Reception/AdminManagement">Admin Management</a>
                                            </li>
                                        </ul>
                                    </li>
                                }
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Admin/Logs">Activity Log</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/User/Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/User/Tracker">Vitals</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/User/Logs">My Log</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="text-muted small d-none d-md-inline"> @user.FirstName @user.LastName (@roles.First())</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-page="/Logout">Sign out</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-primary btn-sm" asp-page="/Login">Sign in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-page="/Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main" role="main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year Hospital Portal</span>
            <a asp-area="" asp-page="/Privacy">Privacy Policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

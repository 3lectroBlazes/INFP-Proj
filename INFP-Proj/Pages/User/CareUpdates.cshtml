@page
@model INFP_Proj.Pages.User.CareUpdatesModel

@{
    ViewData["Title"] = "Appointments & Care Updates";

    string AppointmentStatusBadge(string? status) => status?.ToLower() switch
    {
        "approved" or "scheduled" or "confirmed" => "bg-success",
        "rescheduled" => "bg-info text-dark",
        "awaiting patient" or "pending" => "bg-warning text-dark",
        "rejected" => "bg-danger",
        "cancelled" => "bg-dark",
        _ => "bg-secondary"
    };

    string UrgencyBadge(string? urgency) => urgency?.ToLower() switch
    {
        "emergency" => "bg-danger",
        "urgent" => "bg-warning text-dark",
        _ => "bg-primary"
    };

    string ChangeRequestBadge(string? status) => status?.ToLower() switch
    {
        "approved" => "bg-success",
        "rejected" => "bg-danger",
        "pending" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<style>
    .care-hero {
        background: linear-gradient(135deg,#087f73,#0a9b8c);
        border-radius: 18px;
        color: white;
        padding: 1.75rem;
    }

    .care-card {
        border: 1px solid #dfe9e7;
        border-radius: 15px;
        height: 100%;
        overflow: hidden;
    }

        .care-card .card-header {
            background: white;
            border-bottom: 1px solid #edf2f1;
            color: #006a72;
            font-weight: 700;
            padding: 1rem 1.15rem;
        }

    .appointment-date-panel, .request-change-form, .workflow-box {
        background: #f4f8f7;
        border-radius: 12px;
        padding: 1rem;
    }

    .appointment-date {
        color: #173f3b;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .detail-row {
        border-bottom: 1px solid #edf2f1;
        padding: .7rem 0;
    }

        .detail-row:last-child {
            border-bottom: 0;
        }

    .detail-label {
        color: #6c757d;
        display: block;
        font-size: .78rem;
        margin-bottom: .2rem;
    }

    .detail-value {
        color: #263b38;
        font-weight: 600;
    }

    .section-heading {
        margin-bottom: 1rem;
    }

        .section-heading h2 {
            color: #173f3b;
            font-size: 1.25rem;
        }

    .pending-change-panel {
        background: #fff8e7;
        border: 1px solid #f2d58d;
        border-radius: 12px;
        padding: 1rem;
    }

    .request-change-box {
        border-top: 1px solid #edf2f1;
        margin-top: 1rem;
        padding-top: 1rem;
    }

        .request-change-box summary {
            cursor: pointer;
            list-style: none;
        }

            .request-change-box summary::-webkit-details-marker {
                display: none;
            }

    .info-note {
        background: #f4f8ff;
        border-left: 4px solid #0d6efd;
        border-radius: 10px;
        color: #56657a;
        font-size: .85rem;
        padding: .85rem 1rem;
    }

    .empty-panel {
        background: #f8faf9;
        border: 1px dashed #cbd9d6;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
    }

    .doctor-message {
        background: #f8faf9;
        border: 1px solid #e1eae8;
        border-radius: 12px;
        padding: 1rem;
    }

    .table thead th {
        color: #50615e;
        font-size: .76rem;
        text-transform: uppercase;
        white-space: nowrap;
    }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Appointments & Care Updates</h1>
        <p class="page-subtitle text-muted">
            Review appointments, request another date and book future appointments.
        </p>
    </div>

    <div class="page-actions">
        <a asp-page="/User/Index" class="btn btn-outline-secondary btn-sm">Back to dashboard</a>
    </div>
</div>

@if (TempData["CareUpdateMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["CareUpdateMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["CareUpdateError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["CareUpdateError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.HasPatientRecord)
{
    <div class="alert alert-info">
        <strong>No patient selected.</strong>
        Select a patient from the Dashboard first.
        <div class="mt-3">
            <a asp-page="/User/Index" class="btn btn-primary btn-sm">Go to dashboard</a>
        </div>
    </div>
}
else
{
    <!-- HERO -->
    <section class="care-hero mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="small text-uppercase fw-semibold mb-2">Patient appointment portal</div>
                <h1 class="h3 mb-2">Care updates for @Model.PatientName</h1>
                <p class="mb-0">Review Reception appointments and submit appointment requests.</p>
            </div>

            <span class="badge bg-light text-success rounded-pill px-3 py-2">
                Patient ID: @Model.PatientId
            </span>
        </div>
    </section>

    <!-- RECEPTION APPOINTMENTS -->
    <section class="mb-5">
        <div class="section-heading">
            <h2>Appointments from Reception</h2>
            <p class="text-muted mb-0">
                Reception appointments that may require your confirmation.
            </p>
        </div>

        @if (Model.ConfirmedAppointments.Count == 0)
        {
            <div class="empty-panel text-muted">No upcoming Reception appointments.</div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var appointment in Model.ConfirmedAppointments)
                {
                    <div class="col-lg-6">
                        <article class="care-card card">
                            <div class="card-header d-flex justify-content-between">
                                <span>Appointment #@appointment.AppointmentRequestID</span>
                                <span class="badge @AppointmentStatusBadge(appointment.Status)">
                                    @appointment.Status
                                </span>
                            </div>

                            <div class="card-body">
                                <div class="appointment-date-panel mb-3">
                                    <span class="detail-label">Appointment date and time</span>
                                    <div class="appointment-date">
                                        @Model.FormatAppointmentDate(appointment.DateTime)
                                    </div>
                                </div>

                                <div class="detail-row">
                                    <span class="detail-label">Reason</span>
                                    <div class="detail-value">@appointment.Reason</div>
                                </div>

                                <div class="detail-row">
                                    <span class="detail-label">Urgency</span>
                                    <span class="badge @UrgencyBadge(appointment.Urgency)">
                                        @appointment.Urgency
                                    </span>
                                </div>

                                <div class="workflow-box mt-3">
                                    <div class="fw-semibold mb-2">Appointment acknowledgement</div>

                                    <div class="d-flex gap-3">
                                        <div>
                                            <span class="detail-label">Reception</span>
                                            <span class="badge @(appointment.DocAcknowledged ? "bg-success" : "bg-secondary")">
                                                @(appointment.DocAcknowledged ? "Acknowledged" : "Waiting")
                                            </span>
                                        </div>

                                        <div>
                                            <span class="detail-label">Patient</span>
                                            <span class="badge @(appointment.PatientAcknowledged ? "bg-success" : "bg-warning text-dark")">
                                                @(appointment.PatientAcknowledged ? "Acknowledged" : "Waiting")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(appointment.DoctorResponse))
                                {
                                    <div class="detail-row">
                                        <span class="detail-label">Reception or doctor response</span>
                                        <div class="detail-value">@appointment.DoctorResponse</div>
                                    </div>
                                }

                                @if (appointment.PendingChangeRequest != null)
                                {
                                    var pendingRequest = appointment.PendingChangeRequest;

                                    <div class="pending-change-panel mt-3">
                                        <div class="d-flex justify-content-between mb-3">
                                            <strong>Date-change request</strong>
                                            <span class="badge @ChangeRequestBadge(pendingRequest.Status)">
                                                @pendingRequest.Status
                                            </span>
                                        </div>

                                        <span class="detail-label">Current appointment</span>
                                        <div class="fw-semibold mb-3">
                                            @Model.FormatAppointmentDate(appointment.DateTime)
                                        </div>

                                        <span class="detail-label">Preferred new date</span>
                                        <div class="fw-semibold mb-3">
                                            @Model.FormatAppointmentDate(pendingRequest.RequestedDateTime)
                                        </div>

                                        <span class="detail-label">Reason</span>
                                        <div>@(pendingRequest.Reason ?? "No reason provided")</div>
                                    </div>
                                }

                                <div class="d-flex flex-wrap gap-2 mt-4">
                                    @if (appointment.CanAcknowledge)
                                    {
                                        <form method="post"
                                              asp-page-handler="AcknowledgeAppointment"
                                              asp-route-appointmentId="@appointment.AppointmentRequestID">
                                            <button class="btn btn-primary">Acknowledge appointment</button>
                                        </form>
                                    }

                                    @if (appointment.CanRequestDateChange)
                                    {
                                        <details class="request-change-box w-100">
                                            <summary class="btn btn-outline-primary">Request another date</summary>

                                            <div class="request-change-form mt-3">
                                                <div class="info-note mb-3">
                                                    Reception must approve your requested new date.
                                                </div>

                                                <!-- CHANGED: Separate date + 9AM-5PM hourly time -->
                                                <form method="post"
                                                      asp-page-handler="RequestDateChange"
                                                      asp-route-appointmentId="@appointment.AppointmentRequestID"
                                                      class="appointment-time-form">

                                                    <div class="row g-3 mb-3">
                                                        <div class="col-md-6">
                                                            <label class="form-label">Preferred new date</label>
                                                            <input type="date"
                                                                   class="form-control js-date"
                                                                   min="@Model.MinimumDateValue"
                                                                   required />
                                                        </div>

                                                        <div class="col-md-6">
                                                            <label class="form-label">Time</label>
                                                            <select class="form-select js-time" required>
                                                                <option value="">-- Select Time --</option>
                                                                @for (int hour = 9; hour <= 17; hour++)
                                                                {
                                                                    var time = DateTime.Today.AddHours(hour);
                                                                    <option value="@time.ToString("HH:mm")">
                                                                        @time.ToString("hh:mm tt")
                                                                    </option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <input type="hidden"
                                                           name="requestedDateTime"
                                                           class="js-datetime" />

                                                    <div class="mb-3">
                                                        <label class="form-label">Reason for requesting another date</label>
                                                        <textarea name="changeReason"
                                                  class="form-control"
                                                  rows="3"
                                                  maxlength="500"
                                                  required></textarea>
                                                    </div>

                                                    <button class="btn btn-primary">
                                                        Submit date-change request
                                                    </button>
                                                </form>
                                            </div>
                                        </details>
                                    }
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>

    <!-- PENDING REQUESTS -->
    <section class="mb-5">
        <div class="section-heading">
            <h2>Pending appointment requests</h2>
            <p class="text-muted mb-0">
                Waiting for Reception acknowledgement.
            </p>
        </div>

        @if (Model.PendingAppointments.Count == 0)
        {
            <div class="empty-panel text-muted">There are no pending appointment requests.</div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var appointment in Model.PendingAppointments)
                {
                    <div class="col-md-6 col-xl-4">
                        <article class="care-card card">
                            <div class="card-header d-flex justify-content-between">
                                <span>Request #@appointment.AppointmentRequestID</span>
                                <span class="badge @AppointmentStatusBadge(appointment.Status)">
                                    @appointment.Status
                                </span>
                            </div>

                            <div class="card-body">
                                @if (appointment.PendingChangeRequest != null)
                                {
                                    <div class="appointment-date-panel mb-3">
                                        <span class="detail-label">Requested new date and time</span>
                                        <div class="appointment-date">
                                            @Model.FormatAppointmentDate(
                                            appointment.PendingChangeRequest.RequestedDateTime)
                        </div>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Current appointment date</span>
                        <div class="detail-value">
                            @Model.FormatAppointmentDate(appointment.DateTime)
                        </div>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Reschedule reason</span>
                        <div class="detail-value">
                            @(appointment.PendingChangeRequest.Reason ?? "No reason provided")
                        </div>
                    </div>
                                        }
                                else
                                {
                                    <div class="appointment-date-panel mb-3">
                                        <span class="detail-label">Preferred date and time</span>
                                        <div class="appointment-date">
                                            @Model.FormatAppointmentDate(appointment.DateTime)
                                        </div>
                                    </div>
                                }

                                <div class="detail-row">
                                    <span class="detail-label">Appointment reason</span>
                                    <div class="detail-value">@appointment.Reason</div>
                                </div>

                                <div class="detail-row">
                                    <span class="detail-label">Urgency</span>
                                    <span class="badge @UrgencyBadge(appointment.Urgency)">
                                        @appointment.Urgency
                                    </span>
                                </div>

                                <div class="workflow-box mt-3">
                                    <div class="fw-semibold mb-2">Awaiting agreement</div>

                                    <div class="d-flex gap-3">
                                        <div>
                                            <span class="detail-label">Reception</span>
                                            <span class="badge @(appointment.DocAcknowledged ? "bg-success" : "bg-warning text-dark")">
                                                @(appointment.DocAcknowledged ? "Acknowledged" : "Waiting")
                                            </span>
                                        </div>

                                        <div>
                                            <span class="detail-label">Patient</span>
                                            <span class="badge @(appointment.PatientAcknowledged ? "bg-success" : "bg-secondary")">
                                                @(appointment.PatientAcknowledged ? "Acknowledged" : "Waiting")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>

    <!-- REQUEST CARE -->
    <section class="mb-5">
        <div class="section-heading">
            <h2>Request care</h2>
            <p class="text-muted mb-0">
                Request a future appointment or ask the doctor a question.
            </p>
        </div>

        <div class="row g-4">

            <!-- NEW APPOINTMENT -->
            <div class="col-lg-6">
                <div class="care-card card">
                    <div class="card-header">Request a future appointment</div>

                    <div class="card-body">
                        <div class="info-note mb-4">
                            Your request remains pending until Reception approves it.
                        </div>

                        <!-- CHANGED: Separate date + 9AM-5PM hourly time -->
                        <form method="post"
                              asp-page-handler="RequestNewAppointment"
                              class="appointment-time-form">

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Preferred date</label>
                                    <input type="date"
                                           class="form-control js-date"
                                           min="@Model.MinimumDateValue"
                                           required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Time</label>
                                    <select class="form-select js-time" required>
                                        <option value="">-- Select Time --</option>
                                        @for (int hour = 9; hour <= 17; hour++)
                                        {
                                            var time = DateTime.Today.AddHours(hour);
                                            <option value="@time.ToString("HH:mm")">
                                                @time.ToString("hh:mm tt")
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <input asp-for="NewAppointmentRequest.PreferredDateTime"
                                   type="hidden"
                                   class="js-datetime" />

                            <div class="mb-3">
                                <label asp-for="NewAppointmentRequest.Reason" class="form-label">
                                    Reason for appointment
                                </label>

                                <textarea asp-for="NewAppointmentRequest.Reason"
                                          class="form-control"
                                          rows="4"
                                          maxlength="500"
                                          required></textarea>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewAppointmentRequest.Urgency" class="form-label">Urgency</label>

                                <select asp-for="NewAppointmentRequest.Urgency" class="form-select">
                                    <option value="Normal">Normal</option>
                                    <option value="Urgent">Urgent</option>
                                    <option value="Emergency">Emergency</option>
                                </select>
                            </div>

                            <button class="btn btn-primary">Submit appointment request</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- ASK DOCTOR -->
            <div class="col-lg-6">
                <div class="care-card card">
                    <div class="card-header">Ask the doctor</div>

                    <div class="card-body">
                        <form method="post" asp-page-handler="AskDoctor">
                            <div class="mb-3">
                                <label asp-for="QuestionMessage" class="form-label">
                                    Question or concern
                                </label>

                                <textarea asp-for="QuestionMessage"
                                          class="form-control"
                                          rows="8"
                                          maxlength="1000"
                                          required></textarea>
                            </div>

                            <button class="btn btn-primary">Submit question</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- DATE CHANGE HISTORY -->
    <section class="mb-5">
        <div class="section-heading">
            <h2>Date-change request history</h2>
        </div>

        <div class="care-card card">
            <div class="card-body">
                @if (Model.ChangeRequestHistory.Count == 0)
                {
                    <p class="text-muted mb-0">No date-change requests have been submitted.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Appointment</th>
                                    <th>Current date</th>
                                    <th>Requested date</th>
                                    <th>Reason</th>
                                    <th>Status</th>
                                    <th>Reception response</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var request in Model.ChangeRequestHistory)
                                {
                                    <tr>
                                        <td>#@request.AppointmentRequestID</td>

                                        <td>
                                            @(request.CurrentAppointmentDate.HasValue
                                                                            ? Model.FormatAppointmentDate(request.CurrentAppointmentDate.Value)
                                                                            : "-")
                                                                              </td>

                                        <td>@Model.FormatAppointmentDate(request.RequestedDateTime)</td>
                                        <td>@request.Reason</td>

                                        <td>
                                            <span class="badge @ChangeRequestBadge(request.Status)">
                                                @request.Status
                                            </span>
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(request.ReviewMessage)
                                                                            ? "-"
                                                                            : request.ReviewMessage)
                            </td>
                        </tr>
                                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- APPOINTMENT HISTORY -->
    <section class="mb-5">
        <div class="section-heading">
            <h2>Appointment history</h2>
        </div>

        <div class="care-card card">
            <div class="card-body">
                @if (Model.AppointmentHistory.Count == 0)
                {
                    <p class="text-muted mb-0">No previous appointment records.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Appointment</th>
                                    <th>Date and time</th>
                                    <th>Reason</th>
                                    <th>Urgency</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var appointment in Model.AppointmentHistory)
                                {
                                    <tr>
                                        <td>#@appointment.AppointmentRequestID</td>
                                        <td>@Model.FormatAppointmentDate(appointment.DateTime)</td>
                                        <td>@appointment.Reason</td>

                                        <td>
                                            <span class="badge @UrgencyBadge(appointment.Urgency)">
                                                @appointment.Urgency
                                            </span>
                                        </td>

                                        <td>
                                            <span class="badge @AppointmentStatusBadge(appointment.Status)">
                                                @appointment.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- DOCTOR COMMUNICATION -->
    <section class="mb-4">
        <div class="section-heading">
            <h2>Doctor communication</h2>
        </div>

        <div class="care-card card">
            <div class="card-body">
                @if (Model.DoctorRequests.Count == 0)
                {
                    <p class="text-muted mb-0">No questions have been submitted.</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var request in Model.DoctorRequests)
                        {
                            <div class="col-lg-6">
                                <div class="doctor-message h-100">
                                    <div class="d-flex justify-content-between mb-3">
                                        <span class="badge @(request.Completed ? "bg-success" : "bg-warning text-dark")">
                                            @(request.Completed ? "Replied" : "Awaiting reply")
                                        </span>

                                        <span class="small text-muted">
                                            @Model.FormatUtcDate(request.RequestDate)
                                        </span>
                                    </div>

                                    <span class="detail-label">Patient question</span>
                                    <p>@request.RequestMessage</p>

                                    <span class="detail-label">Doctor response</span>
                                    <p class="mb-0">
                                        @(string.IsNullOrWhiteSpace(request.ReplyMessage)
                                                                    ? "No reply yet."
                                                                    : request.ReplyMessage)
                        </p>
                    </div>
                </div>
                                }
                    </div>
                }
            </div>
        </div>
    </section>
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Combines the Date + Time dropdown into the existing DateTime field.
        document.querySelectorAll('.appointment-time-form').forEach(form => {
            form.addEventListener('submit', function (e) {
                const date = form.querySelector('.js-date')?.value;
                const time = form.querySelector('.js-time')?.value;
                const target = form.querySelector('.js-datetime');

                if (!date || !time || !target) {
                    e.preventDefault();
                    alert('Please select both a date and time.');
                    return;
                }

                target.value = `${date}T${time}:00`;
            });
        });
    </script>
}
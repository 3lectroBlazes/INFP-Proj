@page
@model INFP_Proj.Pages.User.CareUpdatesModel

@{
    ViewData["Title"] = "Appointments & Care Updates";

    string AppointmentStatusBadge(string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "confirmed" => "bg-success",
            "awaiting patient" => "bg-info text-dark",
            "awaiting reception" => "bg-warning text-dark",

            // Older status values retained for compatibility.
            "approved" => "bg-success",
            "scheduled" => "bg-info text-dark",
            "rescheduled" => "bg-info text-dark",
            "pending" => "bg-warning text-dark",

            "rejected" => "bg-danger",
            "cancelled" => "bg-dark",
            "completed" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    string UrgencyBadge(string? urgency)
    {
        return urgency?.Trim().ToLowerInvariant() switch
        {
            "urgent" => "bg-danger",
            "emergency" => "bg-danger",
            _ => "bg-primary"
        };
    }
}

<style>
    .care-hero {
        background: linear-gradient(135deg, #087f73, #0a9b8c);
        border-radius: 18px;
        color: #ffffff;
        padding: 1.75rem;
    }

        .care-hero p {
            color: rgba(255, 255, 255, 0.86);
        }

    .care-card {
        border: 1px solid #dfe9e7;
        border-radius: 15px;
        height: 100%;
        overflow: hidden;
    }

        .care-card .card-header {
            background: #ffffff;
            border-bottom: 1px solid #edf2f1;
            color: #006a72;
            font-weight: 700;
            padding: 1rem 1.15rem;
        }

        .care-card .card-body {
            padding: 1.2rem;
        }

    .appointment-date-panel {
        background: #f4f8f7;
        border-radius: 12px;
        padding: 1rem;
    }

    .appointment-date {
        color: #173f3b;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .detail-row {
        border-bottom: 1px solid #edf2f1;
        padding: 0.7rem 0;
    }

        .detail-row:last-child {
            border-bottom: 0;
        }

    .detail-label {
        color: #6c757d;
        display: block;
        font-size: 0.78rem;
        margin-bottom: 0.2rem;
    }

    .detail-value {
        color: #263b38;
        font-weight: 600;
    }

    .section-heading {
        margin-bottom: 1rem;
    }

        .section-heading h2 {
            color: #173f3b;
            font-size: 1.25rem;
            margin-bottom: 0.25rem;
        }

    .workflow-panel {
        background: #f4f8f7;
        border: 1px solid #dfe9e7;
        border-radius: 12px;
        padding: 0.9rem 1rem;
    }

    .pending-panel {
        background: #fff8e7;
        border: 1px solid #f2d58d;
        border-radius: 12px;
        padding: 0.9rem 1rem;
    }

    .request-change-box {
        border-top: 1px solid #edf2f1;
        margin-top: 1rem;
        padding-top: 1rem;
    }

        .request-change-box summary {
            cursor: pointer;
            display: inline-block;
            list-style: none;
        }

            .request-change-box summary::-webkit-details-marker {
                display: none;
            }

    .request-change-form {
        background: #f8faf9;
        border-radius: 12px;
        margin-top: 1rem;
        padding: 1rem;
    }

    .info-note {
        background: #f4f8ff;
        border-left: 4px solid #0d6efd;
        border-radius: 10px;
        color: #56657a;
        font-size: 0.85rem;
        padding: 0.85rem 1rem;
    }

    .warning-note {
        background: #fff8e7;
        border-left: 4px solid #ffc107;
        border-radius: 10px;
        color: #675b3d;
        font-size: 0.85rem;
        padding: 0.85rem 1rem;
    }

    .empty-panel {
        background: #f8faf9;
        border: 1px dashed #cbd9d6;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
    }

    .doctor-message {
        background: #f8faf9;
        border: 1px solid #e1eae8;
        border-radius: 12px;
        padding: 1rem;
    }

    .table thead th {
        color: #50615e;
        font-size: 0.76rem;
        text-transform: uppercase;
        white-space: nowrap;
    }

    @@media (max-width: 767.98px) {
        .care-hero {
            padding: 1.25rem;
        }
    }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">
            Appointments & Care Updates
        </h1>

        <p class="page-subtitle text-muted">
            Review appointment dates, acknowledge Reception bookings
            and request future care.
        </p>
    </div>

    <div class="page-actions">
        <a asp-page="/User/Dashboard"
           class="btn btn-outline-secondary btn-sm">
            Back to dashboard
        </a>
    </div>
</div>

@if (TempData["CareUpdateMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["CareUpdateMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["CareUpdateError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["CareUpdateError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (!Model.HasPatientRecord)
{
    <div class="alert alert-info">
        No patient record is linked to this account.
    </div>
}
else
{
    <section class="care-hero mb-4">
        <div class="d-flex flex-column flex-lg-row
                        justify-content-between align-items-lg-center gap-3">

            <div>
                <div class="small text-uppercase fw-semibold mb-2">
                    Patient appointment portal
                </div>

                <h1 class="h3 mb-2">
                    Care updates for @Model.PatientName
                </h1>

                <p class="mb-0">
                    Acknowledge dates assigned by Reception or
                    propose another date for Reception to review.
                </p>
            </div>

            <span class="badge bg-light text-success
                             rounded-pill px-3 py-2">
                Patient ID: @Model.PatientId
            </span>
        </div>
    </section>

    <!-- Reception-assigned or approved appointments -->
    <section class="mb-5">
        <div class="section-heading">
            <h2>Appointments from Reception</h2>

            <p class="text-muted mb-0">
                These dates have been assigned or accepted by Reception.
                You may acknowledge the date or propose another date.
            </p>
        </div>

        @if (Model.ConfirmedAppointments.Count == 0)
        {
            <div class="empty-panel">
                <h3 class="h6 mb-2">
                    No upcoming Reception appointments
                </h3>

                <p class="text-muted mb-0">
                    Appointments assigned or approved by Reception
                    will appear here.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var appointment in Model.ConfirmedAppointments)
                {
                    <div class="col-lg-6">
                        <article class="care-card app-card card">

                            <div class="card-header d-flex
                                                    justify-content-between
                                                    align-items-center gap-2">

                                <span>
                                    Appointment
                                    #@appointment.AppointmentRequestID
                                </span>

                                <span class="badge
                                                @AppointmentStatusBadge(
                                      appointment.Status)">
                        @appointment.Status
                    </span>
                </div>

                <div class="card-body">
                    <div class="appointment-date-panel mb-3">
                        <span class="detail-label">
                            Appointment date and time
                        </span>

                        <div class="appointment-date">
                            @Model.FormatAppointmentDate(
                                                        appointment.DateTime)
                        </div>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">
                            Reason
                        </span>

                        <div class="detail-value">
                            @appointment.Reason
                        </div>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">
                            Urgency
                        </span>

                        <span class="badge
                                        @UrgencyBadge(
                                                                          appointment.Urgency)">
                            @appointment.Urgency
                        </span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">
                            Reception acknowledgement
                        </span>

                        @if (appointment.DocAcknowledged)
                                    {
                                        <span class="badge bg-success">
                                            Acknowledged by Reception
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge
                                                                     bg-warning text-dark">
                                            Awaiting Reception
                                        </span>
                                    }
                                </div>

                                <div class="detail-row">
                                    <span class="detail-label">
                                        Patient acknowledgement
                                    </span>

                                    @if (appointment.PatientAcknowledged)
                                    {
                                        <span class="badge bg-success">
                                            Acknowledged
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge
                                                                     bg-info text-dark">
                                            Awaiting your acknowledgement
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                                    appointment.DoctorResponse))
                                {
                                    <div class="detail-row">
                                        <span class="detail-label">
                                            Reception response
                                        </span>

                                        <div class="detail-value">
                                            @appointment.DoctorResponse
                                        </div>
                                    </div>
                                }

                                @if (appointment.Status.Equals(
                                                    "Confirmed",
                                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="workflow-panel mt-3">
                                        <div class="fw-semibold text-success">
                                            Appointment confirmed
                                        </div>

                                        <div class="small text-muted mt-1">
                                            Both Reception and the patient
                                            have acknowledged this date.
                                        </div>
                                    </div>
                                }
                                else if (appointment.Status.Equals(
                                "Awaiting Patient",
                                StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="workflow-panel mt-3">
                                        <div class="fw-semibold">
                                            Your acknowledgement is required
                                        </div>

                                        <div class="small text-muted mt-1">
                                            Reception has accepted this date.
                                            Acknowledge it or propose another date.
                                        </div>
                                    </div>
                                }

                                <div class="d-flex flex-wrap gap-2 mt-4">
                                    @if (appointment.CanAcknowledge)
                                    {
                                        <form method="post"
                                              asp-page-handler="AcknowledgeAppointment"
                                              asp-route-appointmentId="@appointment.AppointmentRequestID"
                                              class="m-0">

                                            <button type="submit"
                                                    class="btn btn-primary">
                                                Acknowledge appointment
                                            </button>
                                        </form>
                                    }

                                    @if (appointment.CanRequestDateChange)
                                    {
                                        <details class="request-change-box w-100">
                                            <summary class="btn btn-outline-primary">
                                                Request another date
                                            </summary>

                                            <div class="request-change-form">
                                                <div class="warning-note mb-3">
                                                    The new date will replace
                                                    the current appointment date
                                                    and will be sent back to
                                                    Reception for confirmation.
                                                </div>

                                                <form method="post"
                                                      asp-page-handler="RequestDateChange"
                                                      asp-route-appointmentId="@appointment.AppointmentRequestID">

                                                    <div class="mb-3">
                                                        <label for="requestedDateTime-@appointment.AppointmentRequestID"
                                                               class="form-label">

                                                            Preferred new date
                                                            and time
                                                        </label>

                                                        <input id="requestedDateTime-@appointment.AppointmentRequestID"
                                                               name="requestedDateTime"
                                                               type="datetime-local"
                                                               class="form-control"
                                                               min="@Model.MinimumDateTimeValue"
                                                               required />
                                                    </div>

                                                    <button type="submit"
                                                            class="btn btn-primary">

                                                        Submit preferred date
                                                    </button>
                                                </form>
                                            </div>
                                        </details>
                                    }
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Patient-proposed dates awaiting Reception -->
    <section class="mb-5">
        <div class="section-heading">
            <h2>Waiting for Reception</h2>

            <p class="text-muted mb-0">
                These appointment dates were proposed by you and
                have not yet been accepted by Reception.
            </p>
        </div>

        @if (Model.PendingAppointments.Count == 0)
        {
            <div class="empty-panel">
                <p class="text-muted mb-0">
                    There are no appointment dates awaiting
                    Reception review.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var appointment in Model.PendingAppointments)
                {
                    <div class="col-md-6 col-xl-4">
                        <article class="care-card app-card card">

                            <div class="card-header d-flex
                                                    justify-content-between
                                                    align-items-center gap-2">

                                <span>
                                    Request
                                    #@appointment.AppointmentRequestID
                                </span>

                                <span class="badge
                                                @AppointmentStatusBadge(
                                      appointment.Status)">
                        @appointment.Status
                    </span>
                </div>

                <div class="card-body">
                    <div class="appointment-date-panel mb-3">
                        <span class="detail-label">
                            Proposed date and time
                        </span>

                        <div class="appointment-date">
                            @Model.FormatAppointmentDate(
                                                        appointment.DateTime)
                        </div>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">
                            Reason
                        </span>

                        <div class="detail-value">
                            @appointment.Reason
                        </div>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">
                            Urgency
                        </span>

                        <span class="badge
                                        @UrgencyBadge(
                                                                          appointment.Urgency)">
                            @appointment.Urgency
                        </span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">
                            Patient acknowledgement
                        </span>

                        @if (appointment.PatientAcknowledged)
                                    {
                                        <span class="badge bg-success">
                                            You proposed this date
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge
                                                                     bg-secondary">
                                            Not acknowledged
                                        </span>
                                    }
                                </div>

                                <div class="detail-row">
                                    <span class="detail-label">
                                        Reception acknowledgement
                                    </span>

                                    <span class="badge
                                                             bg-warning text-dark">
                                        Awaiting Reception
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                                    appointment.DoctorResponse))
                                {
                                    <div class="detail-row">
                                        <span class="detail-label">
                                            Reception response
                                        </span>

                                        <div class="detail-value">
                                            @appointment.DoctorResponse
                                        </div>
                                    </div>
                                }

                                <div class="pending-panel mt-3">
                                    <div class="fw-semibold">
                                        Reception review pending
                                    </div>

                                    <div class="small text-muted mt-1">
                                        Reception must accept this date
                                        or assign a different date.
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>

    <!-- New appointment and doctor question -->
    <section class="mb-5">
        <div class="section-heading">
            <h2>Request care</h2>

            <p class="text-muted mb-0">
                Propose another future appointment or ask the
                doctor a question.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="care-card app-card card">
                    <div class="card-header">
                        Request a future appointment
                    </div>

                    <div class="card-body">
                        <div class="info-note mb-4">
                            You will be proposing the appointment date.
                            Reception must accept it before the appointment
                            becomes confirmed.
                        </div>

                        <form method="post"
                              asp-page-handler="RequestNewAppointment">

                            <div class="mb-3">
                                <label asp-for="NewAppointmentRequest.PreferredDateTime"
                                       class="form-label">

                                    Preferred date and time
                                </label>

                                <input asp-for="NewAppointmentRequest.PreferredDateTime"
                                       type="datetime-local"
                                       class="form-control"
                                       min="@Model.MinimumDateTimeValue"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewAppointmentRequest.Reason"
                                       class="form-label">

                                    Reason for appointment
                                </label>

                                <textarea asp-for="NewAppointmentRequest.Reason"
                                          class="form-control"
                                          rows="4"
                                          maxlength="500"
                                          placeholder="Describe why you need the appointment."
                                          required></textarea>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewAppointmentRequest.Urgency"
                                       class="form-label">

                                    Urgency
                                </label>

                                <select asp-for="NewAppointmentRequest.Urgency"
                                        class="form-select">

                                    <option value="Normal">
                                        Normal
                                    </option>

                                    <option value="Urgent">
                                        Urgent
                                    </option>
                                </select>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary">

                                Submit appointment request
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="care-card app-card card">
                    <div class="card-header">
                        Ask the doctor
                    </div>

                    <div class="card-body">
                        <form method="post"
                              asp-page-handler="AskDoctor">

                            <div class="mb-3">
                                <label asp-for="QuestionMessage"
                                       class="form-label">

                                    Question or concern
                                </label>

                                <textarea asp-for="QuestionMessage"
                                          class="form-control"
                                          rows="8"
                                          maxlength="1000"
                                          placeholder="Enter your question about medication, symptoms or recovery."
                                          required></textarea>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary">

                                Submit question
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Appointment history -->
    <section class="mb-5">
        <div class="section-heading">
            <h2>Appointment history</h2>

            <p class="text-muted mb-0">
                Past, completed, rejected and cancelled appointments.
            </p>
        </div>

        <div class="care-card app-card card">
            <div class="card-body">
                @if (Model.AppointmentHistory.Count == 0)
                {
                    <p class="text-muted mb-0">
                        No previous appointment records.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover
                                              align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Appointment</th>
                                    <th>Date and time</th>
                                    <th>Reason</th>
                                    <th>Urgency</th>
                                    <th>Status</th>
                                    <th>Response</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (
                                                        var appointment
                                                        in Model.AppointmentHistory)
                                {
                                    <tr>
                                        <td>
                                            #@appointment.AppointmentRequestID
                                        </td>

                                        <td class="text-nowrap">
                                            @Model.FormatAppointmentDate(
                                            appointment.DateTime)
                            </td>

                            <td>
                                @appointment.Reason
                            </td>

                            <td>
                                <span class="badge
                                                @UrgencyBadge(
                                                                                          appointment.Urgency)">
                                    @appointment.Urgency
                                </span>
                            </td>

                            <td>
                                <span class="badge
                                                @AppointmentStatusBadge(
                                                                                          appointment.Status)">
                                    @appointment.Status
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(
                                                                appointment.DoctorResponse)
                                                                ? "-"
                                                                : appointment.DoctorResponse)
                            </td>
                        </tr>
                                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Doctor communication -->
    <section class="mb-4">
        <div class="section-heading">
            <h2>Doctor communication</h2>

            <p class="text-muted mb-0">
                Questions submitted by the patient and replies
                from the doctor.
            </p>
        </div>

        <div class="care-card app-card card">
            <div class="card-body">
                @if (Model.DoctorRequests.Count == 0)
                {
                    <p class="text-muted mb-0">
                        No questions have been submitted.
                    </p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (
                                        var request
                                        in Model.DoctorRequests)
                        {
                            <div class="col-lg-6">
                                <div class="doctor-message h-100">

                                    <div class="d-flex
                                                            justify-content-between
                                                            align-items-start
                                                            gap-2 mb-3">

                                        <span class="badge
                                                        @(request.Completed
                                                                                              ? "bg-success"
                                                                                              : "bg-warning text-dark")">

                                            @(request.Completed
                                                                            ? "Replied"
                                                                            : "Awaiting reply")
                            </span>

                                                                        <span class="small text-muted">
                                                                            @Model.FormatUtcDate(
                                                                            request.RequestDate)
                                                                                             </span>
                                                                                         </div>

                                    <div class="detail-label">
                                        Patient question
                                    </div>

                                    <p class="mb-3">
                                        @request.RequestMessage
                                    </p>

                                    <div class="detail-label">
                                        Doctor response
                                    </div>

                                    <p class="mb-0">
                                        @(string.IsNullOrWhiteSpace(
                                                                    request.ReplyMessage)
                                                                    ? "No reply yet."
                                                                    : request.ReplyMessage)
                        </p>
                    </div>
                </div>
                                }
                    </div>
                }
            </div>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
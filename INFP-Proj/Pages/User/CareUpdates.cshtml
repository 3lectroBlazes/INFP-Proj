@page
@model INFP_Proj.Pages.User.CareUpdatesModel
@{
    ViewData["Title"] = "My Care Updates";
    var data = Model.CareData;

    string AppointmentStatusBadge(string status)
    {
        return status switch
        {
            "Approved" => "bg-success",
            "Rejected" => "bg-danger",
            "Rescheduled" => "bg-warning text-dark",
            "Pending" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    string UrgencyBadge(string urgency)
    {
        return urgency switch
        {
            "Urgent" => "bg-danger",
            _ => "bg-primary"
        };
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">My Care Updates</h1>
        <p class="page-subtitle text-muted">
            View upcoming appointments, doctor updates, and submit questions about your care.
        </p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/User/Dashboard">Dashboard</a>
    </div>
</div>

@if (TempData["CareUpdateMessage"] != null)
{
    <div class="alert alert-info">
        @TempData["CareUpdateMessage"]
    </div>
}

@if (!data.HasPatientRecord)
{
    <div class="alert alert-info">
        You do not have an active patient record linked to your account yet.
    </div>
}
else
{
    <div class="hero-panel mb-4">
        <h1 class="mb-3">Care updates for @data.PatientName</h1>
        <p>Keep track of upcoming appointments and communication with the doctor.</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="app-card card h-100">
                <div class="card-header">
                    Upcoming Appointment
                </div>

                <div class="card-body">
                    <p class="mb-2">
                        <strong>Title:</strong> @data.UpcomingAppointment.Title
                    </p>

                    <p class="mb-2">
                        <strong>Doctor:</strong> @data.UpcomingAppointment.DoctorName
                    </p>

                    <p class="mb-2">
                        <strong>Date & Time:</strong>
                        @data.UpcomingAppointment.AppointmentDateTime.ToString("yyyy-MM-dd HH:mm")
                    </p>

                    <p class="mb-2">
                        <strong>Location:</strong> @data.UpcomingAppointment.Location
                    </p>

                    <p class="mb-2">
                        <strong>Status:</strong>
                        @if (data.AppointmentAcknowledged)
                        {
                            <span class="badge bg-success">Acknowledged</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(data.AppointmentChangeRequest))
                        {
                            <span class="badge bg-warning text-dark">Change Requested</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@data.UpcomingAppointment.Status</span>
                        }
                    </p>

                    <p class="mb-3 text-muted">
                        @data.UpcomingAppointment.Purpose
                    </p>

                    @if (!string.IsNullOrWhiteSpace(data.AppointmentChangeRequest))
                    {
                        <div class="alert alert-info mb-3">
                            <strong>Change request submitted:</strong>
                            @data.AppointmentChangeRequest
                        </div>
                    }

                    @if (!data.AppointmentAcknowledged)
                    {
                        <form method="post" asp-page-handler="AcknowledgeAppointment" class="mb-3">
                            <button type="submit" class="btn btn-primary btn-sm">
                                Acknowledge Appointment
                            </button>
                        </form>
                    }

                    <hr />

                    <form method="post" asp-page-handler="RequestAppointmentChange">
                        <div class="mb-3">
                            <label asp-for="AppointmentChangeReason" class="form-label">
                                Cannot attend or need to change?
                            </label>
                            <textarea asp-for="AppointmentChangeReason"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Example: I cannot attend at 10:30 AM. Can we change to afternoon?"></textarea>
                        </div>

                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            Submit Change Request
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="app-card card h-100">
                <div class="card-header">
                    Ask Doctor a Question
                </div>

                <div class="card-body">
                    <form method="post" asp-page-handler="AskDoctor">
                        <div class="mb-3">
                            <label asp-for="QuestionMessage" class="form-label">
                                Question or concern
                            </label>

                            <textarea asp-for="QuestionMessage"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Example: Should the patient take the medication before or after meals?"></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Submit Question
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card card mb-4">
        <div class="card-header">
            Request a New Appointment
        </div>

        <div class="card-body">
            <p class="text-muted">
                Use this if you would like to meet the doctor even though no appointment has been arranged.
            </p>

            <form method="post" asp-page-handler="RequestNewAppointment">
                <div class="mb-3">
                    <label asp-for="NewAppointmentRequest.PreferredDateTime" class="form-label">
                        Preferred Date and Time
                    </label>
                    <input asp-for="NewAppointmentRequest.PreferredDateTime"
                           type="datetime-local"
                           class="form-control" />
                    <span asp-validation-for="NewAppointmentRequest.PreferredDateTime" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewAppointmentRequest.Reason" class="form-label">
                        Reason for Appointment
                    </label>
                    <textarea asp-for="NewAppointmentRequest.Reason"
                              class="form-control"
                              rows="3"
                              placeholder="Example: I would like to discuss my medication, symptoms, or recovery progress."></textarea>
                    <span asp-validation-for="NewAppointmentRequest.Reason" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewAppointmentRequest.Urgency" class="form-label">
                        Urgency
                    </label>
                    <select asp-for="NewAppointmentRequest.Urgency" class="form-select">
                        <option value="Normal">Normal</option>
                        <option value="Urgent">Urgent</option>
                    </select>
                    <span asp-validation-for="NewAppointmentRequest.Urgency" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Submit Appointment Request
                </button>
            </form>
        </div>
    </div>

    <div class="app-card card mb-4">
        <div class="card-header">
            My Appointment Requests
        </div>

        <div class="card-body">
            @if (Model.Appointments.Count == 0)
            {
                <p class="text-muted mb-0">
                    You have not submitted any appointment requests yet.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Preferred Date</th>
                                <th>Reason</th>
                                <th>Urgency</th>
                                <th>Status</th>
                                <th>Doctor Response</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var request in Model.Appointments)
                            {
                                <tr>
                                    <td class="text-nowrap">
                                        @request.PreferredDateTime.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>
                                        @request.Reason
                                    </td>

                                    <td>
                                        <span class="badge @UrgencyBadge(request.Urgency)">
                                            @request.Urgency
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge @AppointmentStatusBadge(request.Status)">
                                            @request.Status
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(request.DoctorResponse)
                                                                    ? "-"
                                                                    : request.DoctorResponse)
                        </td>
                    </tr>
                                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="app-card card mb-4">
        <div class="card-header">
            Latest Doctor Communication
        </div>

        <div class="card-body">
            @if (data.DoctorCommunications.Count == 0)
            {
                <p class="text-muted mb-0">No doctor communication yet.</p>
            }
            else
            {
                var latest = data.DoctorCommunications.First();

                <div class="row g-3 align-items-start">
                    <div class="col-md-8">
                        <p class="mb-2"><strong>Message:</strong></p>
                        <p class="mb-3">@latest.Message</p>

                        <p class="mb-2"><strong>Reply:</strong></p>
                        <p class="mb-0 text-muted">@latest.ReplyMessage</p>
                    </div>

                    <div class="col-md-4">
                        <p class="mb-2">
                            <strong>Status:</strong>
                            @if (latest.Completed)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </p>

                        <p class="mb-0 text-muted">
                            @latest.RequestDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Question & Update History</h2>
    </div>

    @if (data.DoctorCommunications.Count == 0)
    {
        <div class="empty-state">
            <p class="text-muted mb-0">No questions or doctor updates have been recorded yet.</p>
        </div>
    }
    else
    {
        <div class="app-table-wrapper table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Message / Question</th>
                        <th>Reply</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in data.DoctorCommunications)
                    {
                        <tr>
                            <td class="text-nowrap">
                                @item.RequestDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td>@item.Message</td>

                            <td>@item.ReplyMessage</td>

                            <td>
                                @if (item.Completed)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
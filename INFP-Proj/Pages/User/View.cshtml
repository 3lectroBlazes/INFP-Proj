@page "{id:int}"
@model INFP_Proj.Pages.User.ViewModel
@{
    ViewData["Title"] = "View Patient";
}
<script>
    console.log("isRelated:", @Json.Serialize(Model.IsRelated));
    console.log("isOwner:", @Json.Serialize(Model.IsOwner));
</script>
<div class="page-header">
    <div>
        <h1 class="page-title">@Model.Patient.PatientName</h1>
        <p class="page-subtitle text-muted">Update medications or discharge patient.</p>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="app-card card mb-4">
    <div class="card-header">Patient details</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Patient.IsDischarged ? "bg-secondary" : "bg-success")">
                    @Model.Patient.Status
                </span>
            </dd>
            <dt class="col-sm-3 text-muted">Admitted</dt>
            <dd class="col-sm-9">@(Model.Patient.AdmissionDateTime?.ToLocalTime().ToString("g") ?? "—")</dd>
            <dt class="col-sm-3 text-muted">Discharged</dt>
            <dd class="col-sm-9">@(Model.Patient.DischargeDateTime?.ToLocalTime().ToString("g") ?? "—")</dd>
        </dl>
    </div>
</div>

<div class="app-card card mb-4">
    <div class="card-header">Medications</div>
    <div class="card-body">
        @if (Model.Patient.MedicationLists.Count == 0)
        {
            <p class="text-muted mb-0">No medications assigned yet.</p>
        }
        else
        {
            <form method="post" asp-page-handler="UpdateMedications" asp-route-id="@Model.Patient.PatientId">
                <div class="app-table-wrapper table-responsive mb-3">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Medication</th>
                                <th>Dosage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Patient.MedicationLists.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="Patient.MedicationLists[i].MedicationListID" />
                                        <p class="form-control-plaintext">
                                            @(Model.MedicationOptions.FirstOrDefault(m => m.Value == Model.Patient.MedicationLists[i].MedicationID.ToString())?.Text ?? "Unknown")
                                        </p>
                                    </td>
                                    <td>
                                        <p class="form-control-plaintext">@Model.Patient.MedicationLists[i].Dosage</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

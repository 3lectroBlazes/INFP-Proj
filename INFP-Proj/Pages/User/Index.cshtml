@page
@model INFP_Proj.Pages.User.DashboardModel

@{
    ViewData["Title"] = "Patient Dashboard";
    var data = Model.DashboardData;

    string UrgencyBadge(string? urgency) => urgency?.ToLower() switch
    {
        "emergency" => "bg-danger",
        "urgent" => "bg-warning text-dark",
        _ => "bg-primary"
    };

    string StatusBadge(string? status) => status?.ToLower() switch
    {
        "scheduled" or "approved" or "confirmed" => "bg-success",
        "pending" => "bg-warning text-dark",
        "rejected" => "bg-danger",
        _ => "bg-secondary"
    };
}

<style>
    .dashboard-hero {
        background: linear-gradient(135deg,#087f73,#0a9b8c);
        color: white;
        border-radius: 18px;
        padding: 1.75rem;
    }

    .dashboard-card {
        border: 1px solid #dfe9e7;
        border-radius: 14px;
        overflow: hidden;
        height: 100%;
    }

        .dashboard-card .card-header {
            background: white;
            border-bottom: 1px solid #edf2f1;
            color: #006a72;
            font-weight: 700;
            padding: 1rem 1.15rem;
        }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: .7rem 0;
        border-bottom: 1px solid #edf2f1;
    }

        .detail-row:last-child {
            border-bottom: 0;
        }

    .detail-label {
        color: #6c757d;
        font-size: .82rem;
    }

    .detail-value {
        text-align: right;
        font-size: .9rem;
        font-weight: 600;
        color: #263b38;
    }

    .vital-box, .medication-card {
        background: #f5f8f7;
        border-radius: 12px;
        padding: .9rem;
        height: 100%;
    }

    .vital-label {
        color: #6c757d;
        font-size: .75rem;
    }

    .vital-value {
        color: #173f3b;
        font-size: 1.45rem;
        font-weight: 700;
    }

    .vital-unit {
        color: #6c757d;
        font-size: .75rem;
        font-weight: 400;
    }

    .section-heading h2 {
        color: #173f3b;
        font-size: 1.25rem;
    }

    .doctor-message {
        background: #f6f9ff;
        border-left: 4px solid #0d6efd;
        border-radius: 10px;
        padding: 1rem;
    }

    .relation-code-box {
        background: #f8faf9;
        border: 1px solid #dfe9e7;
        border-radius: 10px;
        padding: .55rem .8rem;
    }

    .nurse-box {
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 12px;
        padding: .8rem 1rem;
        min-width: 230px;
    }

        .nurse-box.active {
            background: rgba(220,53,69,.18);
        }

        .nurse-box .btn {
            width: 100%;
        }

    .appointment-box {
        background: #f4f8f7;
        border-radius: 12px;
        padding: 1rem;
    }

    .appointment-date {
        color: #173f3b;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .quick-action {
        display: block;
        height: 100%;
        border: 1px solid #dfe9e7;
        border-radius: 14px;
        padding: 1.15rem;
        text-decoration: none;
        background: white;
        color: inherit;
        transition: .2s;
    }

        .quick-action:hover {
            transform: translateY(-2px);
            border-color: #8cc6bf;
            box-shadow: 0 .5rem 1rem rgba(25,75,68,.08);
            color: inherit;
        }

    .quick-action-title {
        color: #006a72;
        font-weight: 700;
    }

    @@media (max-width: 767.98px) {
        .dashboard-hero {
            padding: 1.25rem;
        }

        .detail-row {
            display: block;
        }

        .detail-value {
            text-align: left;
            margin-top: .2rem;
        }

        .nurse-box {
            width: 100%;
        }
    }
</style>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- PATIENT SELECTION -->
<section class="dashboard-card card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>My patients</span>

        @if (!string.IsNullOrWhiteSpace(Model.OwnRelationCodeShort))
        {
            <div class="relation-code-box small fw-normal">
                <span class="text-muted">Relation Code:</span>
                <code id="relationCode" class="mx-1">@Model.OwnRelationCodeShort</code>
                <button type="button" id="copyRelationCode" class="btn btn-sm btn-outline-secondary py-0">
                    Copy
                </button>
            </div>
        }
    </div>

    <div class="card-body">
        <form method="post" asp-page-handler="ConnectRelation" class="row g-2 align-items-end mb-4">
            <div class="col-md-9">
                <label class="form-label fw-semibold">Connect to a patient</label>
                <div class="small text-muted mb-2">Enter the patient's 8-character Relation Code.</div>
                <input name="relationCode" class="form-control" placeholder="e.g. B04A087F"
                       maxlength="8" pattern="[A-Fa-f0-9]{8}" required />
            </div>

            <div class="col-md-3">
                <button class="btn btn-primary w-100">Connect patient</button>
            </div>
        </form>

        @if (Model.Patients.Count == 0)
        {
            <div class="text-center py-4 text-muted">No patient is linked to this account.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Patient</th>
                            <th>Status</th>
                            <th>Medications</th>
                            <th>Nurse Call</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var patient in Model.Patients)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@patient.PatientName</div>
                                    <div class="small text-muted">Patient ID: @patient.PatientId</div>
                                </td>

                                <td>
                                    <span class="badge @(patient.IsDischarged ? "bg-secondary" : "bg-success")">
                                        @patient.Status
                                    </span>
                                </td>

                                <td class="small text-muted">@patient.MedicationsSummary</td>

                                <td>
                                    <span class="badge @(patient.RequestHelp ? "bg-danger" : "bg-secondary")">
                                        @(patient.RequestHelp ? "Help requested" : "None")
                                    </span>
                                </td>

                                <td class="text-end">
                                    <form method="post" asp-page-handler="SelectPatient">
                                        <input type="hidden" name="patientId" value="@patient.PatientId" />

                                        <button class="btn btn-sm @(Model.SelectedPatientId == patient.PatientId ? "btn-success" : "btn-outline-primary")">
                                            @(Model.SelectedPatientId == patient.PatientId ? "Viewing" : "Open")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@if (!data.HasPatientRecord)
{
    <div class="alert alert-info">
        <strong>No patient selected.</strong> Select a patient above or enter a Relation Code.
    </div>
}
else
{
    <!-- HERO -->
    <section class="dashboard-hero mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="small text-uppercase fw-semibold mb-2">Patient portal</div>
                <h1 class="h3 mb-2">Welcome, @Model.CurrentUserName</h1>
                <p class="mb-0">
                    Viewing <strong>@data.PatientName</strong>
                    · Patient ID: @data.PatientId
                    · @data.HospitalName
                </p>
            </div>

            <div class="d-flex flex-column align-items-lg-end gap-2">
                <span id="overallStatusBadge"
                      class="badge rounded-pill px-3 py-2 @(data.HasUnresolvedEmergency ? "bg-danger" : "bg-light text-success")">
                    @(data.HasUnresolvedEmergency ? "Attention required" : "No urgent alerts")
                </span>

                @if (Model.CanRequestHelp)
                {
                    @if (Model.HelpRequested)
                    {
                        <div class="nurse-box active">
                            <div class="fw-bold mb-1">🔴 Nurse Call Active</div>
                            <div class="small mb-2">Hospital staff have been notified.</div>

                            <form method="post" asp-page-handler="CancelHelp"
                                  onsubmit="return confirm('Cancel your nurse call?');">
                                <button class="btn btn-light btn-sm fw-semibold">Cancel Request</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="nurse-box">
                            <div class="fw-bold mb-1">🔔 Nurse Assistance</div>
                            <div class="small mb-2">Request help from hospital staff.</div>

                            <form method="post" asp-page-handler="RequestHelp"
                                  onsubmit="return confirm('Request nurse assistance?');">
                                <button class="btn btn-warning btn-sm fw-bold">Request Nurse Help</button>
                            </form>
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    <!-- ALERT -->
    <div id="dashboardAlert"
         class="alert @(data.HasUnresolvedEmergency ? "alert-danger" : "alert-success")">
        <strong>@(data.HasUnresolvedEmergency ? "Attention required." : "Current status:")</strong>
        <span id="alertMessageValue">@data.AlertMessage</span>

        @if (data.HasUnresolvedEmergency)
        {
            <a asp-page="/User/Logs" class="btn btn-danger btn-sm ms-3">Review alert</a>
        }
    </div>

    <!-- NEXT APPOINTMENT -->
    <section class="mb-5">
        <div class="section-heading d-flex justify-content-between align-items-end mb-3">
            <div>
                <h2>Next appointment</h2>
                <p class="text-muted mb-0">Your nearest upcoming appointment.</p>
            </div>

            <a asp-page="/User/CareUpdates" class="btn btn-outline-primary btn-sm">
                View appointments
            </a>
        </div>

        <div class="dashboard-card card">
            <div class="card-body">
                @if (Model.NextAppointment == null)
                {
                    <div class="text-center py-3">
                        <div class="text-muted mb-3">No upcoming appointment.</div>
                        <a asp-page="/User/CareUpdates" class="btn btn-primary btn-sm">
                            Request appointment
                        </a>
                    </div>
                }
                else
                {
                    var appointment = Model.NextAppointment;

                    <div class="row g-4 align-items-center">
                        <div class="col-lg-4">
                            <div class="appointment-box">
                                <div class="small text-muted">@appointment.TimeUntil</div>
                                <div class="appointment-date">
                                    @appointment.DateTime.ToString("dd MMM yyyy")
                                </div>
                                <div class="fw-semibold">
                                    @appointment.DateTime.ToString("hh:mm tt")
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="detail-row">
                                <span class="detail-label">Doctor</span>
                                <span class="detail-value">@appointment.DoctorName</span>
                            </div>

                            <div class="detail-row">
                                <span class="detail-label">Reason</span>
                                <span class="detail-value">@appointment.Reason</span>
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <div class="mb-2">
                                <span class="badge @UrgencyBadge(appointment.Urgency)">
                                    @appointment.Urgency
                                </span>

                                <span class="badge @StatusBadge(appointment.Status)">
                                    @appointment.Status
                                </span>
                            </div>

                            <a asp-page="/User/CareUpdates" class="btn btn-primary btn-sm w-100">
                                View Appointment
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- VITALS -->
    <section class="mb-5">
        <div class="section-heading d-flex justify-content-between align-items-end mb-3">
            <div>
                <h2>Latest vitals</h2>
                <p class="text-muted mb-0">Most recent readings recorded for the patient.</p>
            </div>

            <a asp-page="/User/Tracker" class="btn btn-outline-primary btn-sm">
                Open full tracker
            </a>
        </div>

        <div class="dashboard-card card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-lg-3">
                        <div class="vital-box">
                            <div class="vital-label">Heart rate</div>
                            <div class="vital-value">
                                <span id="heartRateValue">@(data.HeartRate?.ToString("0") ?? "N/A")</span>
                                <span class="vital-unit">bpm</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="vital-box">
                            <div class="vital-label">Breathing rate</div>
                            <div class="vital-value">
                                <span id="respirationValue">@(data.RespiratoryRate?.ToString("0") ?? "N/A")</span>
                                <span class="vital-unit">breaths/min</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="vital-box">
                            <div class="vital-label">Systolic pressure</div>
                            <div class="vital-value">
                                <span id="systolicValue">@(data.SystolicBloodPressure?.ToString("0") ?? "N/A")</span>
                                <span class="vital-unit">mmHg</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="vital-box">
                            <div class="vital-label">Diastolic pressure</div>
                            <div class="vital-value">
                                <span id="diastolicValue">@(data.DiastolicBloodPressure?.ToString("0") ?? "N/A")</span>
                                <span class="vital-unit">mmHg</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- MEDICATION -->
    <section class="mb-5">
        <div class="section-heading mb-3">
            <h2>Current medications</h2>
            <p class="text-muted mb-0">Medication, dosage and scheduled consumption time.</p>
        </div>

        <div class="dashboard-card card">
            <div class="card-body">
                @if (data.CurrentMedications.Count == 0)
                {
                    <p class="text-muted mb-0">No active medication has been assigned.</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var med in data.CurrentMedications)
                        {
                            <div class="col-md-6 col-xl-4">
                                <div class="medication-card">
                                    <div class="fw-bold text-primary mb-3">@med.MedicationName</div>
                                    <div class="detail-label">Dosage</div>
                                    <div class="fw-semibold mb-3">@med.Dosage</div>
                                    <div class="detail-label">Scheduled time</div>
                                    <div class="fw-semibold">
                                        @(med.ConsumptionTime?.ToString("HH:mm") ?? "Not scheduled")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- DOCTOR UPDATE -->
    <section class="mb-5">
        <div class="section-heading mb-3">
            <h2>Latest doctor update</h2>
            <p class="text-muted mb-0">Latest communication between the patient and doctor.</p>
        </div>

        <div class="dashboard-card card">
            <div class="card-body">
                @if (!data.HasDoctorRequest)
                {
                    <p class="text-muted mb-0">No doctor communication is available.</p>
                }
                else
                {
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="doctor-message h-100">
                                <div class="small text-uppercase fw-semibold text-muted mb-2">Patient message</div>
                                <p class="mb-0">@data.LatestDoctorRequestMessage</p>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="doctor-message h-100">
                                <div class="d-flex justify-content-between mb-2">
                                    <div class="small text-uppercase fw-semibold text-muted">Doctor response</div>
                                    <span class="badge @(data.LatestDoctorRequestCompleted ? "bg-success" : "bg-warning text-dark")">
                                        @(data.LatestDoctorRequestCompleted ? "Completed" : "Awaiting reply")
                                    </span>
                                </div>

                                <p class="mb-3">@data.LatestDoctorReply</p>
                                <div class="small text-muted">
                                    @(data.LatestDoctorRequestDate?.ToLocalTime()
                                                                .ToString("dd MMM yyyy, hh:mm tt") ?? "Date unavailable")
                        </div>
                    </div>
                </div>
            </div>
                        }
        </div>
    </div>
</section>

<!-- PATIENT OVERVIEW -->
<section class="mb-5">
    <div class="section-heading mb-3">
        <h2>Patient overview</h2>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="dashboard-card card">
                <div class="card-header">Patient details</div>
                <div class="card-body">
                    <div class="detail-row"><span class="detail-label">Full name</span><span class="detail-value">@data.PatientName</span></div>
                    <div class="detail-row"><span class="detail-label">Patient ID</span><span class="detail-value">@data.PatientId</span></div>
                    <div class="detail-row"><span class="detail-label">Status</span><span class="detail-value">@data.PatientStatus</span></div>
                    <div class="detail-row"><span class="detail-label">Weight</span><span class="detail-value">@(data.Weight.HasValue ? $"{data.Weight:0.#} kg" : "Not recorded")</span></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dashboard-card card">
                <div class="card-header">Ward and bed</div>
                <div class="card-body">
                    <div class="detail-row"><span class="detail-label">Ward</span><span class="detail-value">@data.WardName</span></div>
                    <div class="detail-row"><span class="detail-label">Room</span><span class="detail-value">@data.Room</span></div>
                    <div class="detail-row"><span class="detail-label">Floor</span><span class="detail-value">@data.Floor</span></div>
                    <div class="detail-row"><span class="detail-label">Sector</span><span class="detail-value">@data.Sector</span></div>
                    <div class="detail-row"><span class="detail-label">Bed</span><span class="detail-value">@data.BedLocation</span></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dashboard-card card">
                <div class="card-header">Bracelet status</div>
                <div class="card-body">
                    <div class="detail-row">
                        <span class="detail-label">Battery</span>
                        <span class="detail-value"><span id="batteryValue">@(data.BraceletBattery?.ToString("0.0") ?? "N/A")</span>%</span>
                    </div>

                    <div class="detail-row"><span class="detail-label">Movement</span><span id="movementValue" class="detail-value">@(data.Movement?.ToString("0.0") ?? "N/A")</span></div>
                    <div class="detail-row"><span class="detail-label">Location</span><span class="detail-value">@data.BraceletLocation</span></div>

                    <div class="detail-row">
                        <span class="detail-label">Last reading</span>
                        <span id="lastUpdatedValue" class="detail-value">
                            @(data.LatestVitalsRecordedAt?.ToLocalTime()
                                                        .ToString("dd MMM yyyy, hh:mm tt") ?? "No reading")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

    <!-- CARE INFO -->
    <section class="mb-5">
        <div class="section-heading mb-3">
            <h2>Care information</h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="dashboard-card card">
                    <div class="card-header">Hospital and admission</div>
                    <div class="card-body">
                        <div class="detail-row"><span class="detail-label">Hospital</span><span class="detail-value">@data.HospitalName</span></div>
                        <div class="detail-row"><span class="detail-label">Address</span><span class="detail-value">@data.HospitalAddress</span></div>
                        <div class="detail-row"><span class="detail-label">Admission</span><span class="detail-value">@(data.AdmissionDateTime?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "Not recorded")</span></div>
                        <div class="detail-row"><span class="detail-label">Discharge</span><span class="detail-value">@(data.DischargeDateTime?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "Currently admitted")</span></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="dashboard-card card">
                    <div class="card-header">Clinical summary</div>
                    <div class="card-body">
                        <div class="mb-3"><div class="detail-label">Diagnosis</div><div class="fw-semibold">@data.Diagnosis</div></div>
                        <div class="mb-3"><div class="detail-label">Medical record</div><div>@data.RecordDescription</div></div>
                        <div><div class="detail-label">Patient notes</div><div>@data.PatientNotes</div></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- QUICK ACTIONS -->
    <section class="mb-4">
        <div class="section-heading mb-3"><h2>Quick actions</h2></div>

        <div class="row g-4">
            <div class="col-md-4">
                <a asp-page="/User/Tracker" class="quick-action">
                    <div class="quick-action-title">Vitals tracker</div>
                    <div class="small text-muted">Review readings and hourly trends.</div>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-page="/User/Logs" class="quick-action">
                    <div class="quick-action-title">Activity log</div>
                    <div class="small text-muted">Review emergency events.</div>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-page="/User/CareUpdates" class="quick-action">
                    <div class="quick-action-title">Appointments</div>
                    <div class="small text-muted">View, reschedule and request appointments.</div>
                </a>
            </div>
        </div>
    </section>
}

@section Scripts {
    <script>
        function setText(id, value) {
            const el = document.getElementById(id);
            if (el && value != null) el.textContent = value;
        }

        function updateAlert(emergency, message) {
            const box = document.getElementById('dashboardAlert');
            const badge = document.getElementById('overallStatusBadge');

            if (box) {
                box.className = 'alert ' + (emergency ? 'alert-danger' : 'alert-success');
                box.innerHTML =
                    `<strong>${emergency ? 'Attention required.' : 'Current status:'}</strong>
                     <span id="alertMessageValue"></span>
                     ${emergency ? '<a href="/User/Logs" class="btn btn-danger btn-sm ms-3">Review alert</a>' : ''}`;

                setText('alertMessageValue', message);
            }

            if (badge) {
                badge.className = 'badge rounded-pill px-3 py-2 ' +
                    (emergency ? 'bg-danger' : 'bg-light text-success');

                badge.textContent = emergency ? 'Attention required' : 'No urgent alerts';
            }
        }

        async function refreshVitals() {
            try {
                const response = await fetch('?handler=LatestVitals', { cache: 'no-store' });
                if (!response.ok) return;

                const result = await response.json();
                if (!result.success) return;

                setText('heartRateValue', result.heartRate);
                setText('respirationValue', result.respiration);
                setText('systolicValue', result.systolicBloodPressure);
                setText('diastolicValue', result.diastolicBloodPressure);
                setText('batteryValue', result.battery);
                setText('movementValue', result.movement);
                setText('lastUpdatedValue', result.updatedAt);

                updateAlert(result.hasUnresolvedEmergency, result.alertMessage);
            }
            catch { }
        }

        document.getElementById('copyRelationCode')?.addEventListener('click', async function () {
            const code = document.getElementById('relationCode')?.textContent?.trim();
            if (!code) return;

            await navigator.clipboard.writeText(code);

            this.textContent = 'Copied';
            setTimeout(() => this.textContent = 'Copy', 1200);
        });

        @if (data.HasPatientRecord)
        {
                <text>
                    refreshVitals();
                    setInterval(refreshVitals, 30000);
                </text>
        }
    </script>
}
@page
@model INFP_Proj.Pages.User.TrackerModel

@{
    ViewData["Title"] = "My Vitals";

    string BadgeClass(string status)
    {
        return status switch
        {
            "Stable" => "bg-success",
            "Dip" => "bg-warning text-dark",
            "Spike" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    string StatusText(string status)
    {
        return status switch
        {
            "Stable" => "Within the safe range",
            "Dip" => "Below the safe range",
            "Spike" => "Above the safe range",
            _ => "No reading available"
        };
    }
}

<style>
    .tracker-shell {
        max-width: 1500px;
        margin: 0 auto;
    }

    .tracker-header,
    .patient-summary,
    .vital-card {
        background: #ffffff;
        border: 1px solid #dfe9e7;
        border-radius: 16px;
    }

    .tracker-header {
        padding: 1.5rem;
        margin-bottom: 1.25rem;
    }

    .patient-summary {
        padding: 1.25rem 1.5rem;
        margin-bottom: 1rem;
    }

    .eyebrow {
        color: #006a72;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .status-banner {
        border-radius: 14px;
        padding: 1rem 1.1rem;
    }

    .simulation-note {
        background: #f5f8ff;
        border: 1px solid #cfe0ff;
        border-left: 4px solid #0d6efd;
        border-radius: 12px;
        padding: 1rem 1.1rem;
    }

    .vital-card {
        height: 100%;
        overflow: hidden;
    }

        .vital-card .card-body {
            display: flex;
            flex-direction: column;
            height: 100%;
            padding: 1.2rem;
        }

    .vital-header {
        border-bottom: 1px solid #edf2f1;
        margin-bottom: 0.75rem;
        padding-bottom: 0.75rem;
    }

    .vital-title {
        color: #006a72;
        font-size: 1rem;
        font-weight: 700;
        margin: 0;
    }

    .reading-block {
        margin-bottom: 0.85rem;
    }

    .reading-label,
    .section-label {
        color: #64748b;
        font-size: 0.75rem;
    }

    .vital-reading {
        color: #173f3b;
        font-size: 2rem;
        font-weight: 750;
        line-height: 1.1;
    }

    .vital-unit {
        color: #64748b;
        font-size: 0.8rem;
    }

    .status-description {
        display: block;
        color: #64748b;
        font-size: 0.75rem;
        margin-top: 0.35rem;
    }

    .safe-range {
        background: #f5f8f7;
        border-radius: 12px;
        margin-bottom: 1rem;
        padding: 0.9rem;
    }

    .safe-range-value {
        color: #173f3b;
        font-size: 1rem;
        font-weight: 700;
        margin-top: 0.15rem;
    }

    .simulation-panel {
        border-top: 1px solid #edf2f1;
        margin-top: auto;
        padding-top: 0.9rem;
    }

    .simulation-buttons {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.45rem;
    }

        .simulation-buttons .btn {
            font-size: 0.78rem;
            padding: 0.45rem 0.3rem;
        }

    @@media (max-width: 767.98px) {
        .tracker-header,
        .patient-summary {
            padding: 1.1rem;
        }
    }
</style>


<div class="tracker-shell">

    <!-- ===================================================== -->
    <!-- HEADER                                                -->
    <!-- ===================================================== -->

    <section class="tracker-header">

        <div class="d-flex flex-column flex-lg-row
                    justify-content-between align-items-lg-center gap-3">

            <div>

                <div class="eyebrow mb-2">
                    Patient monitoring
                </div>

                <h1 class="h3 mb-2">
                    My vitals
                </h1>

                <p class="text-muted mb-0">
                    View the latest readings and safe range for each vital.
                </p>

            </div>


            <a asp-page="/User/Dashboard"
               class="btn btn-outline-secondary btn-sm">
                Back to dashboard
            </a>

        </div>

    </section>


    <!-- ===================================================== -->
    <!-- SUCCESS MESSAGE                                       -->
    <!-- ===================================================== -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Message"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- ===================================================== -->
    <!-- ERROR MESSAGE                                         -->
    <!-- ===================================================== -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- ===================================================== -->
    <!-- NO PATIENT SELECTED                                   -->
    <!-- ===================================================== -->
    @if (!Model.HasPatientRecord)
    {
        <div class="alert alert-info">

            <strong>No patient selected.</strong>

            Select a patient from the dashboard first before
            viewing the vitals tracker.

            <div class="mt-3">

                <a asp-page="/User/Dashboard"
                   class="btn btn-primary btn-sm">
                    Go to dashboard
                </a>

            </div>

        </div>
    }
    else
    {
        var cards = new[]
        {
        new
        {
        Title = "Heart rate",

        ValueId =
        "heartRateValue",

        StatusId =
        "heartRateStatus",

        DescriptionId =
        "heartRateDescription",

        RangeId =
        "heartRateRangeValue",

        Vital =
        "HeartRate",

        Value =
        Model.LatestHeartRate?.ToString("0")
        ?? "N/A",

        Unit =
        "bpm",

        Status =
        Model.HeartRateStatus,

        Range =
        $"{Model.HeartRateLowerThreshold:0.#}" +
        $"–{Model.HeartRateUpperThreshold:0.#}"
        },

        new
        {
        Title = "Breathing rate",

        ValueId =
        "respirationValue",

        StatusId =
        "respirationStatus",

        DescriptionId =
        "respirationDescription",

        RangeId =
        "respiratoryRangeValue",

        Vital =
        "RespiratoryRate",

        Value =
        Model.LatestRespiration?.ToString("0")
        ?? "N/A",

        Unit =
        "breaths/min",

        Status =
        Model.RespirationStatus,

        Range =
        $"{Model.RespiratoryRateLowerThreshold:0.#}" +
        $"–{Model.RespiratoryRateUpperThreshold:0.#}"
        },

        new
        {
        Title = "Systolic pressure",

        ValueId =
        "SystolicbloodPressureValue",

        StatusId =
        "SystolicbloodPressureStatus",

        DescriptionId =
        "systolicDescription",

        RangeId =
        "systolicRangeValue",

        Vital =
        "SystolicBloodPressure",

        Value =
        Model.LatestSystolicBloodPressure?.ToString("0")
        ?? "N/A",

        Unit =
        "mmHg",

        Status =
        Model.SystolicStatus,

        Range =
        $"{Model.SystolicLowerThreshold:0.#}" +
        $"–{Model.SystolicUpperThreshold:0.#}"
        },

        new
        {
        Title = "Diastolic pressure",

        ValueId =
        "DiastolicbloodPressureValue",

        StatusId =
        "DiastolicbloodPressureStatus",

        DescriptionId =
        "diastolicDescription",

        RangeId =
        "diastolicRangeValue",

        Vital =
        "DiastolicBloodPressure",

        Value =
        Model.LatestDiastolicBloodPressure?.ToString("0")
        ?? "N/A",

        Unit =
        "mmHg",

        Status =
        Model.DiastolicStatus,

        Range =
        $"{Model.DiastolicLowerThreshold:0.#}" +
        $"–{Model.DiastolicUpperThreshold:0.#}"
        }
        };


        <!-- ================================================= -->
        <!-- PATIENT SUMMARY                                   -->
        <!-- ================================================= -->

        <section class="patient-summary">

            <div class="d-flex flex-column flex-lg-row
                            justify-content-between align-items-lg-center gap-3">

                <div>

                    <div class="eyebrow mb-1">
                        Patient being monitored
                    </div>

                    <h2 class="h4 mb-1">
                        @Model.ChartData.PatientName
                    </h2>


                    <div class="text-muted">

                        Latest reading:

                        <strong id="latestUpdatedValue"
                                class="text-dark">

                            @(Model.LatestUpdatedAt.HasValue
                                                    ? Model.LatestUpdatedAt.Value
                                                    .ToString(
                                                    "dd MMM yyyy, hh:mm:ss tt")
                                                    : "No reading recorded")

                        </strong>

                    </div>

                </div>


                <span id="overallStatusBadge"
                      class="badge rounded-pill px-3 py-2
                                 @(Model.HasAttention
                                                       ? "bg-danger"
                                                       : "bg-success")">

                    @(Model.HasAttention
                                    ? "Attention required"
                                    : "Patient stable")

                </span>

            </div>

        </section>


        <!-- ================================================= -->
        <!-- OVERALL STATUS                                    -->
        <!-- ================================================= -->

        <div id="patientStatusAlert"
             class="status-banner alert
                        @(Model.HasAttention
                                     ? "alert-danger"
                                     : "alert-success")
                    mb-4">

        @if (Model.HasAttention)
            {
                <strong>
                    Attention required.
                </strong>

                <span>
                    One or more readings are outside their safe ranges.
                </span>
            }
            else
            {
                <strong>
                    Latest readings are stable.
                </strong>

                <span>
                    All readings are within their safe ranges.
                </span>
            }

        </div>


        <!-- ================================================= -->
        <!-- TEST CONTROL EXPLANATION                          -->
        <!-- ================================================= -->

        <div class="simulation-note mb-4">

            <strong>
                Test controls
            </strong>

            <div class="small text-muted mt-1">

                Spike creates a simulated reading above the safe range.

                Dip creates a simulated reading below the safe range.

                Stable creates a simulated reading within the safe range.

                These controls are for testing vital readings only.

            </div>

        </div>


        <!-- ================================================= -->
        <!-- VITAL CARDS                                       -->
        <!-- ================================================= -->

        <div class="row g-4 mb-5">

            @foreach (var card in cards)
            {
                <div class="col-md-6 col-xl-3">

                    <article class="vital-card card">

                        <div class="card-body">

                            <!-- ================================= -->
                            <!-- TITLE                             -->
                            <!-- ================================= -->

                            <header class="vital-header">

                                <h2 class="vital-title">
                                    @card.Title
                                </h2>

                            </header>


                            <!-- ================================= -->
                            <!-- CURRENT READING                   -->
                            <!-- ================================= -->

                            <div class="reading-block">

                                <div class="reading-label">
                                    Current reading
                                </div>


                                <div class="mt-1">

                                    <span id="@card.ValueId"
                                          class="vital-reading">
                                        @card.Value
                                    </span>

                                    <span class="vital-unit">
                                        @card.Unit
                                    </span>

                                </div>


                                <div class="mt-3">

                                    <span id="@card.StatusId"
                                          class="badge @BadgeClass(card.Status)">

                                        @card.Status

                                    </span>


                                    <span id="@card.DescriptionId"
                                          class="status-description">

                                        @StatusText(card.Status)

                                    </span>

                                </div>

                            </div>


                            <!-- ================================= -->
                            <!-- SAFE RANGE                        -->
                            <!-- ================================= -->

                            <div class="safe-range">

                                <div class="section-label">
                                    Safe range
                                </div>


                                <div class="safe-range-value">

                                    <span id="@card.RangeId">
                                        @card.Range
                                    </span>

                                    @card.Unit

                                </div>

                            </div>


                            <!-- ================================= -->
                            <!-- SIMULATION BUTTONS                -->
                            <!-- ================================= -->

                            <div class="simulation-panel">

                                <div class="small fw-semibold mb-2">
                                    Create test reading
                                </div>


                                <form method="post"
                                      asp-page-handler="SimulateVital">

                                    <input type="hidden"
                                           name="vital"
                                           value="@card.Vital" />


                                    <div class="simulation-buttons">

                                        <button type="submit"
                                                name="direction"
                                                value="Spike"
                                                class="btn btn-outline-danger">

                                            Spike

                                        </button>


                                        <button type="submit"
                                                name="direction"
                                                value="Dip"
                                                class="btn btn-outline-warning">

                                            Dip

                                        </button>


                                        <button type="submit"
                                                name="direction"
                                                value="Stable"
                                                class="btn btn-outline-success">

                                            Stable

                                        </button>

                                    </div>

                                </form>

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>


        <!-- ================================================= -->
        <!-- HOURLY CHARTS                                     -->
        <!-- ================================================= -->

        <section>

            <h2 class="h4">
                Hourly trends
            </h2>


            <p class="text-muted">

                Each chart point shows the average readings
                recorded during that hour.

            </p>


            <partial name="_VitalsTracker"
                     model="Model.ChartData" />

        </section>
    }

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js">
    </script>

    <script src="~/js/vitals-tracker.js"
            asp-append-version="true">
    </script>


    @if (Model.HasPatientRecord)
    {
        <script>

            function setText(elementId, value) {

                const element =
                    document.getElementById(elementId);

                if (
                    element &&
                    value !== undefined &&
                    value !== null
                ) {
                    element.textContent = value;
                }
            }


            function getStatusText(status) {

                if (status === 'Stable') {
                    return 'Within the safe range';
                }

                if (status === 'Dip') {
                    return 'Below the safe range';
                }

                if (status === 'Spike') {
                    return 'Above the safe range';
                }

                return 'No reading available';
            }


            function updateStatus(
                badgeId,
                descriptionId,
                status
            ) {

                const badge =
                    document.getElementById(badgeId);

                if (badge) {

                    badge.textContent =
                        status;

                    badge.className =
                        'badge';


                    if (status === 'Stable') {

                        badge.classList.add(
                            'bg-success'
                        );

                    }
                    else if (status === 'Dip') {

                        badge.classList.add(
                            'bg-warning',
                            'text-dark'
                        );

                    }
                    else if (status === 'Spike') {

                        badge.classList.add(
                            'bg-danger'
                        );

                    }
                    else {

                        badge.classList.add(
                            'bg-secondary'
                        );

                    }
                }


                setText(
                    descriptionId,
                    getStatusText(status)
                );
            }


            function updatePatientStatus(
                hasAttention
            ) {

                const alertBox =
                    document.getElementById(
                        'patientStatusAlert'
                    );

                const statusBadge =
                    document.getElementById(
                        'overallStatusBadge'
                    );


                if (alertBox) {

                    alertBox.className =
                        'status-banner alert mb-4 ' +
                        (
                            hasAttention
                                ? 'alert-danger'
                                : 'alert-success'
                        );


                    alertBox.innerHTML =
                        hasAttention
                            ?
                            '<strong>Attention required.</strong> ' +
                            'One or more readings are outside ' +
                            'their safe ranges.'
                            :
                            '<strong>Latest readings are stable.</strong> ' +
                            'All readings are within their safe ranges.';

                }


                if (statusBadge) {

                    statusBadge.className =
                        'badge rounded-pill px-3 py-2 ' +
                        (
                            hasAttention
                                ? 'bg-danger'
                                : 'bg-success'
                        );


                    statusBadge.textContent =
                        hasAttention
                            ? 'Attention required'
                            : 'Patient stable';

                }
            }


            async function refreshLatestVitals() {

                try {

                    /*
                     * READ ONLY.
                     *
                     * This does not create a new vital reading.
                     */
                    const response =
                        await fetch(
                            '?handler=LatestVitals',
                            {
                                cache: 'no-store'
                            }
                        );


                    if (!response.ok) {

                        console.log(
                            'Unable to refresh latest vitals.'
                        );

                        return;
                    }


                    const data =
                        await response.json();


                    if (!data.success) {

                        console.log(
                            data.message
                        );

                        return;
                    }


                    setText(
                        'heartRateValue',
                        data.heartRate
                    );


                    setText(
                        'respirationValue',
                        data.respiration
                    );


                    setText(
                        'SystolicbloodPressureValue',
                        data.systolicBloodPressure
                    );


                    setText(
                        'DiastolicbloodPressureValue',
                        data.diastolicBloodPressure
                    );


                    setText(
                        'latestUpdatedValue',
                        data.updatedAt
                    );


                    setText(
                        'heartRateRangeValue',
                        data.heartRateLower +
                        '–' +
                        data.heartRateUpper
                    );


                    setText(
                        'respiratoryRangeValue',
                        data.respiratoryLower +
                        '–' +
                        data.respiratoryUpper
                    );


                    setText(
                        'systolicRangeValue',
                        data.systolicLower +
                        '–' +
                        data.systolicUpper
                    );


                    setText(
                        'diastolicRangeValue',
                        data.diastolicLower +
                        '–' +
                        data.diastolicUpper
                    );


                    updateStatus(
                        'heartRateStatus',
                        'heartRateDescription',
                        data.heartRateStatus
                    );


                    updateStatus(
                        'respirationStatus',
                        'respirationDescription',
                        data.respirationStatus
                    );


                    updateStatus(
                        'SystolicbloodPressureStatus',
                        'systolicDescription',
                        data.systolicStatus
                    );


                    updateStatus(
                        'DiastolicbloodPressureStatus',
                        'diastolicDescription',
                        data.diastolicStatus
                    );


                    updatePatientStatus(
                        data.hasAttention
                    );

                }
                catch (error) {

                    console.error(
                        'Unable to refresh latest vitals:',
                        error
                    );

                }
            }


            /*
             * Refresh once when the page loads,
             * then every 30 seconds.
             *
             * This ONLY reads the newest saved reading.
             */
            refreshLatestVitals();


            setInterval(
                refreshLatestVitals,
                30000
            );

        </script>
    }

}
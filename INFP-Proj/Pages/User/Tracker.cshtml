@page
@model INFP_Proj.Pages.User.TrackerModel
@{
    ViewData["Title"] = "My Vitals";
}

<div class="page-header">
    <div>
        <h1 class="page-title">My vitals</h1>
        <p class="page-subtitle text-muted">Your health metrics over time.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/User/Dashboard">Dashboard</a>
    </div>
</div>

<partial name="_VitalsTracker" model="Model.ChartData" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/vitals-tracker.js" asp-append-version="true"></script>
}

@page
@model INFP_Proj.Pages.User.DashboardModel
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">My Dashboard</h1>
        <p class="page-subtitle text-muted">Your vitals and personal activity.</p>
    </div>
</div>

<div class="dashboard-grid">
    <a class="dashboard-tile" asp-page="/User/Tracker">
        <span class="dashboard-tile-title">Vitals tracker</span>
        <p class="dashboard-tile-desc">View your health metrics over time.</p>
    </a>
    <a class="dashboard-tile" asp-page="/User/Logs">
        <span class="dashboard-tile-title">My activity log</span>
        <p class="dashboard-tile-desc">Events related to your care and account.</p>
    </a>
</div>

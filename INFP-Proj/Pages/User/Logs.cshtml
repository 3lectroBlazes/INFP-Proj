@page
@model INFP_Proj.Pages.User.LogsModel
@{
    ViewData["Title"] = "My Activity Log";
}

<div class="page-header">
    <div>
        <h1 class="page-title">My activity log</h1>
        <p class="page-subtitle text-muted">Personal history for <strong>@Model.CurrentUserName</strong> (newest first).</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/User/Dashboard">Dashboard</a>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["Message"]</div>
}

@if (Model.Logs.Count == 0)
{
    <div class="empty-state">
        <p class="text-muted mb-0">No log entries for your account yet.</p>
    </div>
}
else
{
    <div class="app-table-wrapper table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Event</th>
                    <th>Emergency</th>
                    <th>Acknowledgement</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Logs)
                {
                    string rowClass = entry.Emergency
                        ? (entry.Resolved ? "table-success" : "table-danger")
                        : "";

                    <tr class="@rowClass">
                        <td class="text-nowrap">
                            <time datetime="@entry.Timestamp.ToString("o")">
                                @entry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                            </time>
                        </td>
                        <td>@entry.Event</td>
                        <td>
                            @if (entry.Emergency)
                            {
                                <span class="badge bg-danger">Yes</span>
                            }
                            else
                            {
                                <span class="text-muted">No</span>
                            }
                        </td>
                        <td>
                            @if (!entry.Emergency)
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                            else if (entry.Resolved)
                            {
                                <span class="badge bg-success">Resolved</span>
                            }
                            else if (entry.CurrentUserAcknowledged)
                            {
                                <span class="badge bg-success">You acknowledged this</span>
                            }
                            else if (entry.CanAcknowledge)
                            {
                                <form method="post" asp-page-handler="Acknowledge" asp-route-id="@entry.LogId" class="m-0">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Acknowledge</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">Pending</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@page
@model INFP_Proj.Pages.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <h1>Sign out</h1>
        <p class="auth-lead">Are you sure you want to sign out?</p>
        <form method="post" class="d-flex flex-column gap-2">
            <button class="btn btn-primary" asp-page-handler="Logout">Yes, sign out</button>
            <button class="btn btn-outline-secondary" asp-page-handler="DontLogout">Stay signed in</button>
        </form>
    </div>
</div>
